  }

  /* ------------------------------------------------------- responsive */
  @media (max-width: 1080px) {
    .strip {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .about {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
    .about__lead {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 980px) {
    .hero__inner {
      grid-template-columns: minmax(0, 1fr);
    }
    .feature__slide {
      grid-template-columns: minmax(0, 1fr);
    }
    .feature__rail {
      grid-template-columns: auto minmax(0, 1fr) auto;
    }
    .hero__stage {
      min-height: 28rem;
      max-width: 30rem;
    }
    .feature__stage {
      order: -1;
    }
    .project-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .section__head {
      grid-template-columns: minmax(0, 1fr);
      align-items: start;
    }
    .feature__tabs {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 700px) {
    .hero__facts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .hero__stage {
      min-height: 23rem;
      max-width: 24rem;
    }
    .hero__slot--back {
      display: none;
    }
    .hero__slot--mid {
      left: -2%;
      bottom: 0;
      width: 116px;
    }
    .hero__slot--front {
      right: 4%;
      top: 4%;
      width: 172px;
    }
    .hero__tag--b {
      display: none;
    }
    .hero__tag--c {
      right: 0;
      bottom: 22%;
    }
    .project-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .strip {
      grid-template-columns: minmax(0, 1fr);
    }
    .about {
      grid-template-columns: minmax(0, 1fr);
    }
    .feature__stats {
      grid-template-columns: minmax(0, 1fr);
    }
    .feature__mini {
      display: none;
    }
  }
</style>

<script>
  // Reveal on scroll.
  const revealables = document.querySelectorAll<HTMLElement>('[data-reveal]');
  if ('IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.setAttribute('data-reveal', 'in');
          observer.unobserve(entry.target);
        });
      },
      { rootMargin: '0px 0px -8% 0px', threshold: 0.08 }
    );
    revealables.forEach((element) => observer.observe(element));
  } else {
    revealables.forEach((element) => element.setAttribute('data-reveal', 'in'));
  }

  // Platform filter.
  const filterRoot = document.querySelector<HTMLElement>('[data-filter]');
  const grid = document.querySelector<HTMLElement>('[data-project-grid]');
  if (filterRoot && grid) {
    const buttons = Array.from(filterRoot.querySelectorAll<HTMLButtonElement>('[data-filter-value]'));
    const cards = Array.from(grid.querySelectorAll<HTMLElement>('[data-project-card]'));
    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        const value = button.dataset.filterValue ?? 'All';
        buttons.forEach((other) => {
          const active = other === button;
          other.classList.toggle('is-active', active);
          other.setAttribute('aria-pressed', String(active));
        });
        cards.forEach((card) => {
          const show = value === 'All' || card.dataset.platform === value;
          card.classList.toggle('is-hidden', !show);
        });
      });
    });
  }

  // Project showcase carousel.
  const carousel = document.querySelector<HTMLElement>('[data-carousel]');
  if (carousel) {
    const slides = Array.from(
      carousel.querySelectorAll<HTMLElement>('[data-carousel-slide]')
    );
    const tabs = Array.from(carousel.querySelectorAll<HTMLButtonElement>('[data-carousel-tab]'));
    const section = carousel;
    let index = 0;

    const show = (next: number, focusTab = false) => {
      index = (next + slides.length) % slides.length;
      slides.forEach((slide, i) => {
        const active = i === index;
        slide.classList.toggle('is-active', active);
        slide.setAttribute('aria-hidden', String(!active));
      });
      tabs.forEach((tab, i) => {
        const active = i === index;
        tab.classList.toggle('is-active', active);
        tab.setAttribute('aria-selected', String(active));
        tab.tabIndex = active ? 0 : -1;
      });
      const project = slides[index]?.dataset.accent;
      if (project) section.style.setProperty('--accent', project);
      if (focusTab) tabs[index]?.focus();
    };

    slides.forEach((slide) => {
      const accent = slide.getAttribute('style')?.match(/--accent:\s*([^;]+)/)?.[1];
      if (accent) slide.dataset.accent = accent.trim();
    });
    const initial = slides[0]?.dataset.accent;
    if (initial) section.style.setProperty('--accent', initial);

    carousel
      .querySelector('[data-carousel-prev]')
      ?.addEventListener('click', () => show(index - 1));
    carousel
      .querySelector('[data-carousel-next]')
      ?.addEventListener('click', () => show(index + 1));
    tabs.forEach((tab, i) => tab.addEventListener('click', () => show(i)));

    carousel.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowRight') {
        event.preventDefault();
        show(index + 1);
      }
      if (event.key === 'ArrowLeft') {
        event.preventDefault();
        show(index - 1);
      }
    });

    // Swipe between projects on touch devices.
    let startX: number | null = null;
    carousel.addEventListener(
      'touchstart',
      (event) => {
        startX = event.changedTouches[0]?.clientX ?? null;
      },
      { passive: true }
    );
    carousel.addEventListener(
      'touchend',
      (event) => {
        if (startX === null) return;
        const delta = (event.changedTouches[0]?.clientX ?? startX) - startX;
        if (Math.abs(delta) > 56) show(index + (delta < 0 ? 1 : -1));
        startX = null;
      },
      { passive: true }
    );
  }

  // Back to top.
  const toTop = document.querySelector<HTMLButtonElement>('[data-to-top]');
  if (toTop) {
    const onScroll = () => toTop.classList.toggle('is-visible', window.scrollY > 900);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
    toTop.addEventListener('click', () =>
      window.scrollTo({ top: 0, behavior: 'smooth' })
    );
  }
</script>
