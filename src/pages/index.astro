---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import PhoneFrame from '../components/PhoneFrame.astro';
import WindowFrame from '../components/WindowFrame.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects, bySlug } from '../data/projects';
import { site } from '../data/site';

const ironpulse = bySlug('ironpulse');
const calcsuite = bySlug('calcsuite');
const hunter = bySlug('discount-hunter');
const codescope = bySlug('codescope');

const galleryStrip = [
  {
    project: ironpulse,
    src: '/img/ironpulse/exercise.webp',
    alt: 'An IronPulse exercise detail page with the movement animation and instructions.',
    caption: 'Exercise detail — animation and instructions',
  },
  {
    project: calcsuite,
    src: '/img/calcsuite/calculus.webp',
    alt: 'The Calculator Suite function graphing tool with a shaded area under the curve.',
    caption: 'Function graphing with f, f′ and the area',
  },
  {
    project: hunter,
    src: '/img/discounthunter/detail.webp',
    alt: 'A Discount Hunter game page comparing the price in GOG and in Steam.',
    caption: '“Where to buy” across every store',
  },
  {
    project: codescope,
    src: '/img/codescope/report.webp',
    alt: 'The CodeScope report dashboard showing metric cards and the language breakdown.',
    caption: 'The in-app analysis dashboard',
  },
];
---

<BaseLayout
  title="JuggyBob — four independent apps for Android and Windows"
  description="IronPulse, Calculator Suite, Discount Hunter and CodeScope: four independent applications for Android and Windows, built by JuggyBob. Offline by default, no account, no tracking."
>
  <a class="skip-link" href="#main">Skip to content</a>
  <Header />

  <main id="main">
    <!-- ============================================================ hero -->
    <section class="hero">
      <div class="hero__grid" aria-hidden="true"></div>
      <div class="hero__glow" aria-hidden="true"></div>

      <div class="wrap wrap-wide hero__inner">
        <div class="hero__copy">
          <p class="eyebrow" data-reveal>Independent software · Android &amp; Windows</p>
          <h1 class="hero__title" data-reveal style="--reveal-delay:60ms">
            Four apps built to be <span class="grad">used</span>, not just downloaded.
          </h1>
          <p class="lede hero__lede" data-reveal style="--reveal-delay:120ms">
            A workout logger with a 1,333-movement library. A mathematics toolkit with
            sixty-six calculators and a circuit editor. A deal feed that merges Steam, GOG and
            Epic. And a native Windows front end for the <span class="mono">scc</span> code-analysis
            engine.
          </p>

          <div class="hero__actions" data-reveal style="--reveal-delay:180ms">
            <a class="btn" href="#apps">
              <span>Explore the apps</span>
              <Icon name="arrow-right" size={15} />
            </a>
            <a class="btn btn--ghost" href={site.github} target="_blank" rel="noopener noreferrer">
              <Icon name="github" size={15} />
              <span>GitHub profile</span>
            </a>
          </div>

          <dl class="hero__facts" data-reveal style="--reveal-delay:240ms">
            <div>
              <dt class="mono">Projects</dt>
              <dd>4</dd>
            </div>
            <div>
              <dt class="mono">Platforms</dt>
              <dd>Android · Windows</dd>
            </div>
            <div>
              <dt class="mono">Accounts</dt>
              <dd>None</dd>
            </div>
            <div>
              <dt class="mono">Trackers</dt>
              <dd>None</dd>
            </div>
          </dl>
        </div>

        <div class="hero__stage" data-reveal style="--reveal-delay:120ms">
          <div class="hero__slot hero__slot--back">
            <WindowFrame
              src="/img/codescope/report.webp"
              alt="The CodeScope report dashboard with metric cards and a language breakdown table."
              title="CodeScope — report"
            />
          </div>
          <div class="hero__slot hero__slot--mid">
            <PhoneFrame
              src="/img/calcsuite/calculus.webp"
              alt="The Calculator Suite function graphing tool."
              sizes="(max-width: 720px) 40vw, 170px"
            />
          </div>
          <div class="hero__slot hero__slot--front">
            <PhoneFrame
              src="/img/ironpulse/dashboard.webp"
              alt="The IronPulse home dashboard on a phone."
              loading="eager"
              sizes="(max-width: 720px) 62vw, 230px"
            />
          </div>
          <span class="hero__tag hero__tag--a">IronPulse</span>
          <span class="hero__tag hero__tag--b">Calculator Suite</span>
          <span class="hero__tag hero__tag--c">CodeScope</span>
        </div>
      </div>
    </section>

    <!-- ================================================== featured apps -->
    <section class="feature" id="feature" data-carousel>
      <div class="wrap wrap-wide feature__inner">
        <div class="feature__rail">
          <button class="feature__nav feature__nav--prev" type="button" data-carousel-prev aria-label="Show the previous project">
            <Icon name="chevron-left" size={18} />
          </button>

          <div class="feature__slides">
            {
              projects.map((project, index) => (
                <article
                  class={`feature__slide ${index === 0 ? 'is-active' : ''}`}
                  data-carousel-slide
                  data-index={index}
                  aria-hidden={index === 0 ? 'false' : 'true'}
                  style={`--accent:${project.accent};--accent-ink:${project.accentInk}`}
                >
                  <div class="feature__copy">
                    <p class="feature__flag">
                      <span class="feature__flag-label">{project.showcase.label}</span>
                      <span class="feature__flag-index mono">
                        {String(index + 1).padStart(2, '0')} / {String(projects.length).padStart(2, '0')}
                      </span>
                    </p>
                    <h2 class="feature__title">
                      <span class="feature__name">{project.name}</span>
                      {project.tagline}
                    </h2>
                    <p class="lede">{project.summary}</p>

                    <ul class="feature__list">
                      {project.highlights.map((point) => (
                        <li>
                          <Icon name="check" size={14} />
                          <span>{point}</span>
                        </li>
                      ))}
                    </ul>

                    <div class="feature__actions">
                      <a class="btn btn--accent" href={`/apps/${project.slug}/`}>
                        <span>Open the product page</span>
                        <Icon name="arrow-right" size={15} />
                      </a>
                      <a class="btn btn--ghost" href={project.releases} target="_blank" rel="noopener noreferrer">
                        <Icon name="download" size={15} />
                        <span>Latest release</span>
                      </a>
                      <a class="btn btn--ghost" href={project.repo} target="_blank" rel="noopener noreferrer">
                        <Icon name="github" size={15} />
                        <span>Source code</span>
                      </a>
                    </div>

                    <dl class="feature__stats">
                      {project.facts.slice(0, 4).map((fact) => (
                        <div>
                          <dt class="mono">{fact.label}</dt>
                          <dd>{fact.value}</dd>
                        </div>
                      ))}
                    </dl>
                  </div>

                  <div class="feature__stage">
                    <div class="feature__art">
                      {project.showcase.hero.frame === 'window' ? (
                        <div class="feature__window-slot">
                          <WindowFrame
                            src={project.showcase.hero.src}
                            alt={project.showcase.hero.alt}
                            title={`${project.name} — report`}
                          />
                        </div>
                      ) : (
                        <div class="feature__phone-slot">
                          <PhoneFrame
                            src={project.showcase.hero.src}
                            alt={project.showcase.hero.alt}
                            loading={index === 0 ? 'eager' : 'lazy'}
                            sizes="(max-width: 900px) 62vw, 280px"
                          />
                        </div>
                      )}
                    </div>
                    <figure class="feature__mini">
                      <img
                        src={project.showcase.detail.src}
                        alt={project.showcase.detail.alt}
                        loading="lazy"
                        decoding="async"
                        width="900"
                        height="2000"
                      />
                      <figcaption>{project.showcase.detail.alt}</figcaption>
                    </figure>
                  </div>
                </article>
              ))
            }
          </div>

          <button class="feature__nav feature__nav--next" type="button" data-carousel-next aria-label="Show the next project">
            <Icon name="chevron-right" size={18} />
          </button>
        </div>

        <div class="feature__tabs" role="tablist" aria-label="Choose a project">
          {
            projects.map((project, index) => (
              <button
                class={`feature__tab ${index === 0 ? 'is-active' : ''}`}
                type="button"
                role="tab"
                data-carousel-tab
                data-index={index}
                aria-selected={index === 0 ? 'true' : 'false'}
                tabindex={index === 0 ? '0' : '-1'}
                style={`--accent:${project.accent}`}
              >
                <span class="feature__tab-icon">
                  <img src={project.icon} alt="" width="30" height="30" loading="lazy" decoding="async" />
                </span>
                <span class="feature__tab-text">
                  <span class="feature__tab-name">{project.name}</span>
                  <span class="feature__tab-meta mono">{project.platform}</span>
                </span>
              </button>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ================================================ project directory -->
    <section class="section" id="apps">
      <div class="wrap wrap-wide">
        <div class="section__head">
          <div>
            <p class="eyebrow" data-reveal>The directory</p>
            <h2 data-reveal style="--reveal-delay:60ms">Everything here, in one place.</h2>
          </div>
          <p class="section__note" data-reveal style="--reveal-delay:120ms">
            Three applications for Android and one native Windows tool. Filter by the platform
            they run on.
          </p>
        </div>

        <div class="filter" role="group" aria-label="Filter projects by platform" data-filter>
          <button class="filter__btn is-active" type="button" data-filter-value="All" aria-pressed="true">
            All
            <span class="mono">{projects.length}</span>
          </button>
          <button class="filter__btn" type="button" data-filter-value="Android" aria-pressed="false">
            Android
            <span class="mono">{projects.filter((p) => p.platform === 'Android').length}</span>
          </button>
          <button class="filter__btn" type="button" data-filter-value="Windows" aria-pressed="false">
            Windows
            <span class="mono">{projects.filter((p) => p.platform === 'Windows').length}</span>
          </button>
        </div>

        <div class="project-grid" data-project-grid>
          {
            projects.map((project, index) => (
              <ProjectCard
                project={project}
                variant={index === 0 ? 'wide' : 'default'}
              />
            ))
          }
        </div>
      </div>
    </section>

    <!-- ========================================================== gallery -->
    <section class="section section--strip" id="gallery">
      <div class="wrap wrap-wide">
        <div class="section__head">
          <div>
            <p class="eyebrow" data-reveal>Inside the apps</p>
            <h2 data-reveal style="--reveal-delay:60ms">This is what they actually look like.</h2>
          </div>
          <p class="section__note" data-reveal style="--reveal-delay:120ms">
            Real screens from the released applications — no mock-ups, no stock photography.
            Each one opens the product page it belongs to.
          </p>
        </div>

        <div class="strip">
          {
            galleryStrip.map((item, index) => (
              <a
                class="strip__card"
                href={`/apps/${item.project.slug}/`}
                style={`--accent:${item.project.accent}`}
                data-reveal
                data-reveal-delay={`${index * 70}ms`}
              >
                <span class="strip__frame">
                  <img
                    src={item.src}
                    alt={item.alt}
                    loading="lazy"
                    decoding="async"
                    width="900"
                    height="2000"
                  />
                </span>
                <span class="strip__meta">
                  <span class="strip__name">{item.project.name}</span>
                  <span class="strip__caption">{item.caption}</span>
                </span>
                <span class="strip__arrow"><Icon name="arrow-up-right" size={16} /></span>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ============================================================ about -->
    <section class="section" id="about">
      <div class="wrap wrap-wide about">
        <div class="about__lead">
          <p class="eyebrow" data-reveal>About</p>
          <h2 data-reveal style="--reveal-delay:60ms">
            One developer, four applications, no company behind them.
          </h2>
        </div>
        <div class="about__body">
          <p data-reveal style="--reveal-delay:100ms">
            JuggyBob is the name I build and ship under. Everything on this site is
            independent software I design, implement, test and release myself — Android
            applications written in Kotlin with Jetpack Compose, and a native Windows desktop
            tool written in WPF on .NET.
          </p>
          <p data-reveal style="--reveal-delay:140ms">
            The apps share a set of values, because I wanted them for myself first: they work
            without an account, they work without a network, they do not carry analytics or
            advertising, and the data you put into them stays on your device. Where a feature
            genuinely needs the internet — live store prices, exchange rates, an AI provider —
            it is opt-in, and the app says plainly what it sends.
          </p>
          <p data-reveal style="--reveal-delay:180ms">
            The source code for all four is public, issues and pull requests are welcome, and
            every release ships with a checksum so you can verify what you downloaded.
          </p>
          <p class="about__method" data-reveal style="--reveal-delay:210ms">
            <span class="mono about__method-label">Method</span>
            <span>
              I design the architecture, write the specifications and domain models, do the
              API and prompt-engineering work and run the testing and quality assurance —
              and the code itself is written with AI assistant workflows. It is worth
              knowing before you read the source.
            </span>
          </p>
          <div class="about__actions" data-reveal style="--reveal-delay:220ms">
            <a class="btn" href={site.github} target="_blank" rel="noopener noreferrer">
              <Icon name="github" size={15} />
              <span>Follow on GitHub</span>
            </a>
            <span class="mono about__handle">@{site.githubHandle}</span>
          </div>
        </div>
        <ul class="about__repos" data-reveal style="--reveal-delay:160ms">
          {
            projects.map((project) => (
              <li style={`--accent:${project.accent}`}>
                <a href={project.repo} target="_blank" rel="noopener noreferrer">
                  <span class="about__repo-icon">
                    <img src={project.icon} alt="" width="36" height="36" loading="lazy" decoding="async" />
                  </span>
                  <span class="about__repo-text">
                    <span class="about__repo-name">{project.name}</span>
                    <span class="about__repo-desc">{project.tagline}</span>
                  </span>
                  <Icon name="arrow-up-right" size={15} />
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  </main>

  <Footer />

  <button class="to-top" type="button" data-to-top aria-label="Back to top">
    <Icon name="arrow-right" size={16} />
  </button>
</BaseLayout>

<style>
  /* ------------------------------------------------------------ hero */
  .hero {
    position: relative;
    padding-block: clamp(3rem, 7vw, 6rem) clamp(3.5rem, 7vw, 6rem);
    overflow: hidden;
  }
  .hero__grid {
    position: absolute;
    inset: -20% -10% auto -10%;
    height: 140%;
    background-image:
      linear-gradient(to right, var(--line) 1px, transparent 1px),
      linear-gradient(to bottom, var(--line) 1px, transparent 1px);
    background-size: 64px 64px;
    mask-image: radial-gradient(85% 65% at 55% 30%, #000 0%, transparent 78%);
    -webkit-mask-image: radial-gradient(85% 65% at 55% 30%, #000 0%, transparent 78%);
    opacity: 0.75;
    pointer-events: none;
  }
  .hero__glow {
    position: absolute;
    top: -20%;
    left: 52%;
    width: 62rem;
    height: 62rem;
    transform: translateX(-30%);
    background: radial-gradient(
      circle,
      color-mix(in srgb, var(--brand) 16%, transparent) 0%,
      transparent 62%
    );
    pointer-events: none;
  }
  .hero__inner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.02fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(2rem, 5vw, 4.5rem);
  }
  .hero__title {
    margin-top: 1.1rem;
  }
  .hero__lede {
    margin-top: 1.4rem;
    max-width: 52ch;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: 2rem;
  }
  .hero__facts {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, auto));
    gap: clamp(1rem, 3vw, 2.4rem);
    margin-top: 2.6rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }
  .hero__facts dt {
    font-size: 0.66rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-3);
  }
  .hero__facts dd {
    margin: 0.3rem 0 0;
    font-size: 0.98rem;
    font-weight: 560;
    letter-spacing: -0.015em;
  }

  .hero__stage {
    position: relative;
    min-height: 31rem;
    aspect-ratio: 1 / 1;
    max-width: 34rem;
    margin-inline: auto;
    width: 100%;
  }
  .hero__slot {
    position: absolute;
  }
  .hero__slot--back {
    top: -3%;
    right: -7%;
    width: min(96%, 30rem);
    opacity: 0.5;
    transform: rotate(-2.4deg);
    filter: saturate(0.8);
    mask-image: linear-gradient(to bottom, #000 58%, transparent 97%);
    -webkit-mask-image: linear-gradient(to bottom, #000 58%, transparent 97%);
  }
  .hero__slot--mid {
    left: -3%;
    bottom: 1%;
    width: 158px;
    transform: rotate(-7deg);
    z-index: 1;
  }
  .hero__slot--front {
    right: 10%;
    top: 7%;
    width: 214px;
    transform: rotate(2.4deg);
    z-index: 3;
  }
  .hero__tag {
    position: absolute;
    z-index: 4;
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-2);
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.32rem 0.62rem;
    white-space: nowrap;
  }
  .hero__tag--a {
    right: 2%;
    bottom: 2%;
  }
  .hero__tag--b {
    left: -2%;
    bottom: -1%;
  }
  .hero__tag--c {
    left: 4%;
    top: 3%;
  }

  /* ------------------------------------------------------ featured app */
  .feature {
    position: relative;
    padding-block: clamp(3.5rem, 8vw, 6rem);
    border-block: 1px solid var(--line);
    background:
      radial-gradient(
        90% 120% at 85% 10%,
        color-mix(in srgb, var(--accent, var(--brand)) 12%, transparent) 0%,
        transparent 55%
      ),
      var(--bg-2);
    overflow: hidden;
    transition: background 0.6s var(--ease);
  }
  .feature__inner {
    display: flex;
    flex-direction: column;
    gap: clamp(1.5rem, 3vw, 2.2rem);
  }
  .feature__rail {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: clamp(0.5rem, 1.5vw, 1.4rem);
  }
  .feature__slides {
    display: grid;
    min-width: 0;
  }
  .feature__slide {
    grid-area: 1 / 1;
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr);
    gap: clamp(1.6rem, 4vw, 3.5rem);
    align-items: center;
    opacity: 0;
    visibility: hidden;
    transform: translateY(14px);
    transition:
      opacity 0.5s var(--ease),
      transform 0.6s var(--ease-out),
      visibility 0.5s;
  }
  .feature__slide.is-active {
    opacity: 1;
    visibility: visible;
    transform: none;
  }
  .feature__nav {
    display: grid;
    place-items: center;
    width: 2.8rem;
    height: 2.8rem;
    border-radius: 999px;
    border: 1px solid var(--line-2);
    color: var(--text-2);
    background: color-mix(in srgb, var(--surface) 70%, transparent);
    backdrop-filter: blur(6px);
    transition:
      color 0.2s var(--ease),
      border-color 0.2s var(--ease),
      background-color 0.2s var(--ease),
      transform 0.2s var(--ease);
  }
  .feature__nav:hover {
    color: var(--text);
    border-color: var(--text-3);
    background: var(--surface-2);
  }
  .feature__nav:active {
    transform: scale(0.94);
  }
  .feature__title {
    margin-top: 0.9rem;
    max-width: 20ch;
  }
  .feature__name {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.8rem;
  }
  .feature__flag {
    display: flex;
    align-items: baseline;
    gap: 0.9rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .feature__flag-label {
    color: var(--accent);
  }
  .feature__flag-index {
    color: var(--text-3);
    letter-spacing: 0.14em;
  }
  .feature__copy .lede {
    margin-top: 1.1rem;
  }
  .feature__list {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    margin-top: 1.6rem;
  }
  .feature__list li {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    font-size: 0.95rem;
    color: var(--text-2);
  }
  .feature__list svg {
    flex: none;
    margin-top: 0.32em;
    color: var(--accent);
  }
  .feature__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 2rem;
  }
  .feature__stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem 1.5rem;
    margin-top: 2.2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }
  .feature__stats dt {
    font-size: 0.64rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-3);
  }
  .feature__stats dd {
    margin: 0.25rem 0 0;
    font-size: 0.9rem;
    font-weight: 520;
  }

  .feature__stage {
    position: relative;
    display: flex;
    justify-content: center;
  }
  .feature__art {
    width: 100%;
    display: flex;
    justify-content: center;
  }
  .feature__phone-slot {
    width: 268px;
    transform: rotate(2deg);
  }
  .feature__window-slot {
    width: 100%;
    transform: rotate(-1deg);
  }
  .feature__mini {
    position: absolute;
    left: 0;
    bottom: -2.5rem;
    width: 8.5rem;
    margin: 0;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid var(--line-2);
    background: var(--surface);
    box-shadow: var(--shadow-lg);
    transform: rotate(-4deg);
  }
  .feature__mini img {
    width: 100%;
    height: auto;
    display: block;
  }
  .feature__mini figcaption {
    padding: 0.5rem 0.6rem;
    font-size: 0.66rem;
    line-height: 1.35;
    color: var(--text-3);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .feature__tabs {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.5rem;
    padding-top: clamp(1rem, 2vw, 1.6rem);
    border-top: 1px solid var(--line);
  }
  .feature__tab {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.6rem 0.75rem;
    border-radius: var(--radius-sm);
