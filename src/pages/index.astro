---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import HomeHero from '../components/HomeHero.astro';
import PhoneFrame from '../components/PhoneFrame.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects, bySlug } from '../data/projects';
import { site } from '../data/site';

const ironpulse = bySlug('ironpulse');
const calcsuite = bySlug('calcsuite');
const hunter = bySlug('discount-hunter');
const codescope = bySlug('codescope');

const strip = [
  {
    project: ironpulse,
    src: '/img/ironpulse/exercise.webp',
    alt: 'An IronPulse exercise detail page with the movement animation and coaching instructions.',
    caption: 'Exercise detail — animation and instructions',
  },
  {
    project: calcsuite,
    src: '/img/calcsuite/calculus.webp',
    alt: 'The Calculator Suite function graphing tool with its derivative and the area under the curve.',
    caption: 'Function graphing with f, f′ and the area',
  },
  {
    project: hunter,
    src: '/img/discounthunter/detail.webp',
    alt: 'A Discount Hunter game page comparing the price in GOG and in Steam.',
    caption: '“Where to buy” across every store',
  },
  {
    project: codescope,
    src: '/img/codescope/report.webp',
    alt: 'The CodeScope report dashboard showing metric cards and the language breakdown.',
    caption: 'The in-app analysis dashboard',
  },
];
---

<BaseLayout
  title="JuggyBob — four independent apps for Android and Windows"
  description="IronPulse, Calculator Suite, Discount Hunter and CodeScope: four independent applications for Android and Windows, built by JuggyBob. Offline by default, no account, no tracking."
>
  <a class="skip-link" href="#main">Skip to content</a>
  <Header />

  <main id="main">
    <HomeHero />

    <!-- ====================================================== showcase -->
    <section class="showcase" id="showcase" data-carousel style={`--accent:${ironpulse.accent}`}>
      <div class="wrap wrap-wide">
        <div class="showcase__head">
          <div>
            <p class="eyebrow" data-reveal="rise">The collection</p>
            <h2 data-reveal="rise" style="--reveal-delay:60ms">Four products, one workshop.</h2>
          </div>
          <div class="showcase__nav">
            <span class="showcase__counter mono" data-carousel-counter>01 / 04</span>
            <button class="showcase__arrow" type="button" data-carousel-prev aria-label="Show the previous project">
              <Icon name="chevron-left" size={17} />
            </button>
            <button class="showcase__arrow" type="button" data-carousel-next aria-label="Show the next project">
              <Icon name="chevron-right" size={17} />
            </button>
          </div>
        </div>

        <div class="showcase__stage" data-carousel-stage>
          {
            projects.map((project, index) => (
              <article
                class={`showcase__slide ${index === 0 ? 'is-active' : ''}`}
                data-carousel-slide
                data-index={index}
                aria-hidden={index === 0 ? 'false' : 'true'}
                style={`--accent:${project.accent};--accent-ink:${project.accentInk}`}
              >
                <div class="showcase__copy">
                  <p class="showcase__label mono">
                    <span class="showcase__dot" aria-hidden="true" />
                    {project.showcase.label}
                    <span class="showcase__platform">
                      <Icon
                        name={project.platform === 'Android' ? 'android' : 'windows'}
                        size={12}
                      />
                      {project.platform}
                    </span>
                  </p>
                  <h3 class="showcase__name">{project.name}</h3>
                  <p class="showcase__tagline">{project.tagline}</p>
                  <p class="showcase__body">{project.summary}</p>

                  <ul class="showcase__points">
                    {project.highlights.map((point) => (
                      <li>
                        <Icon name="check" size={13} />
                        <span>{point}</span>
                      </li>
                    ))}
                  </ul>

                  <div class="showcase__actions">
                    <a class="btn btn--accent" href={`/apps/${project.slug}/`}>
                      <span>Open {project.name}</span>
                      <Icon name="arrow-right" size={15} />
                    </a>
                    <a
                      class="btn btn--ghost"
                      href={project.releases}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      <Icon name="download" size={15} />
                      <span>Latest release</span>
                    </a>
                  </div>
                </div>

                <div class="showcase__art">
                  {project.showcase.hero.frame === 'window' ? (
                    <div class="showcase__window">
                      <div class="showcase__windowbar" aria-hidden="true">
                        <i />
                        <i />
                        <i />
                        <span class="mono">{project.name} — report</span>
                      </div>
                      <img
                        src={project.showcase.hero.src}
                        alt={project.showcase.hero.alt}
                        loading={index === 0 ? 'eager' : 'lazy'}
                        decoding="async"
                        width="1800"
                        height="976"
                      />
                    </div>
                  ) : (
                    <div class="showcase__phone">
                      <PhoneFrame
                        src={project.showcase.hero.src}
                        alt={project.showcase.hero.alt}
                        loading={index === 0 ? 'eager' : 'lazy'}
                        sizes="(max-width: 900px) 60vw, 260px"
                      />
                    </div>
                  )}
                  <figure class="showcase__mini">
                    <img
                      src={project.showcase.detail.src}
                      alt={project.showcase.detail.alt}
                      loading="lazy"
                      decoding="async"
                      width="900"
                      height="2000"
                    />
                  </figure>
                </div>
              </article>
            ))
          }
        </div>

        <div class="showcase__tabs" role="tablist" aria-label="Choose a project">
          {
            projects.map((project, index) => (
              <button
                class={`showcase__tab ${index === 0 ? 'is-active' : ''}`}
                type="button"
                role="tab"
                data-carousel-tab
                data-index={index}
                aria-selected={index === 0 ? 'true' : 'false'}
                tabindex={index === 0 ? '0' : '-1'}
                style={`--accent:${project.accent}`}
              >
                <span class="showcase__tab-icon">
                  <img src={project.icon} alt="" width="30" height="30" loading="lazy" decoding="async" />
                </span>
                <span class="showcase__tab-text">
                  <span class="showcase__tab-name">{project.name}</span>
                  <span class="showcase__tab-meta mono">{project.platform}</span>
                </span>
              </button>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ====================================================== directory -->
    <section class="section" id="apps">
      <div class="wrap wrap-wide">
        <div class="section__head">
          <div>
            <p class="eyebrow" data-reveal="rise">The directory</p>
            <h2 data-reveal="rise" style="--reveal-delay:60ms">Everything here, in one place.</h2>
          </div>
          <p class="section__note" data-reveal="side-r" style="--reveal-delay:120ms">
            Three applications for Android and one native Windows tool. Filter by the platform
            they run on.
          </p>
        </div>

        <div class="filter" role="group" aria-label="Filter projects by platform" data-filter>
          <button class="filter__btn is-active" type="button" data-filter-value="All" aria-pressed="true">
            All
            <span class="mono">{projects.length}</span>
          </button>
          <button class="filter__btn" type="button" data-filter-value="Android" aria-pressed="false">
            Android
            <span class="mono">{projects.filter((p) => p.platform === 'Android').length}</span>
          </button>
          <button class="filter__btn" type="button" data-filter-value="Windows" aria-pressed="false">
            Windows
            <span class="mono">{projects.filter((p) => p.platform === 'Windows').length}</span>
          </button>
        </div>

        <div class="project-grid" data-project-grid>
          {
            projects.map((project, index) => (
              <ProjectCard project={project} variant={index === 0 ? 'wide' : 'default'} />
            ))
          }
        </div>
      </div>
    </section>

    <!-- ==================================================== deep-dive band -->
    <section class="band" aria-label="Discount Hunter">
      <div class="wrap wrap-wide band__inner">
        <div class="band__art" data-reveal="side">
          <div class="band__phones">
            <PhoneFrame
              src="/img/discounthunter/feed.webp"
              alt="The Discount Hunter deals feed showing live discounts from Steam, GOG and the Epic Games Store."
              loading="lazy"
              sizes="(max-width: 900px) 42vw, 230px"
            />
            <PhoneFrame
              src="/img/discounthunter/detail.webp"
              alt="A Discount Hunter game page comparing the GOG and Steam price for the same game."
              loading="lazy"
              sizes="(max-width: 900px) 42vw, 230px"
            />
          </div>
        </div>
        <div class="band__copy" data-reveal="rise" style="--reveal-delay:80ms">
          <p class="eyebrow">Game deals · Android</p>
          <h2>One feed instead of three storefronts.</h2>
          <p class="lede">
            Discount Hunter reads the live discount feeds of Steam, GOG and the Epic Games
            Store, merges them into one daily list, and compares the price in every store that
            has the game. Save a title and it tells you when the price drops — with the app
            closed.
          </p>
          <ul class="band__points">
            {
              hunter.highlights.map((point) => (
                <li>
                  <Icon name="check" size={14} />
                  <span>{point}</span>
                </li>
              ))
            }
          </ul>
          <a class="btn btn--accent" href={`/apps/${hunter.slug}/`} style={`--accent:${hunter.accent};--accent-ink:${hunter.accentInk}`}>
            <span>Open Discount Hunter</span>
            <Icon name="arrow-right" size={15} />
          </a>
        </div>
      </div>
    </section>

    <!-- ========================================================== strip -->
    <section class="section section--strip" id="gallery">
      <div class="wrap wrap-wide">
        <div class="section__head">
          <div>
            <p class="eyebrow" data-reveal="rise">Inside the apps</p>
            <h2 data-reveal="rise" style="--reveal-delay:60ms">This is what they actually look like.</h2>
          </div>
          <p class="section__note" data-reveal="side-r" style="--reveal-delay:120ms">
            Real screens from the released applications — no mock-ups, no stock photography.
            Each one opens the product page it belongs to.
          </p>
        </div>

        <div class="strip">
          {
            strip.map((item, index) => (
              <a
                class="strip__card"
                href={`/apps/${item.project.slug}/`}
                data-reveal="rise"
                style={`--accent:${item.project.accent};--reveal-delay:${index * 70}ms`}
              >
                <span class="strip__frame">
                  <img
                    src={item.src}
                    alt={item.alt}
                    loading="lazy"
                    decoding="async"
                    width="900"
                    height="2000"
                  />
                </span>
                <span class="strip__meta">
                  <span class="strip__name">{item.project.name}</span>
                  <span class="strip__caption">{item.caption}</span>
                </span>
                <span class="strip__arrow"><Icon name="arrow-up-right" size={16} /></span>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ========================================================== about -->
    <section class="section" id="about">
      <div class="wrap wrap-wide about">
        <div class="about__lead">
          <p class="eyebrow" data-reveal="rise">About</p>
          <h2 data-reveal="rise" style="--reveal-delay:60ms">
            One developer, four applications, no company behind them.
          </h2>
        </div>
        <div class="about__body">
          <p data-reveal="rise" style="--reveal-delay:100ms">
            JuggyBob is the name I build and ship under. Everything on this site is
            independent software I design, implement, test and release myself — Android
            applications written in Kotlin with Jetpack Compose, and a native Windows desktop
            tool written in WPF on .NET.
          </p>
          <p data-reveal="rise" style="--reveal-delay:140ms">
            The apps share a set of values, because I wanted them for myself first: they work
            without an account, they work without a network, they do not carry analytics or
            advertising, and the data you put into them stays on your device. Where a feature
            genuinely needs the internet — live store prices, exchange rates, an AI provider —
            it is opt-in, and the app says plainly what it sends.
          </p>
          <p data-reveal="rise" style="--reveal-delay:180ms">
            The source code for all four is public, issues and pull requests are welcome, and
            every release ships with a checksum so you can verify what you downloaded.
          </p>
          <p class="about__method" data-reveal="rise" style="--reveal-delay:210ms">
            <span class="mono about__method-label">Method</span>
            <span>
              I design the architecture, write the specifications and domain models, do the
              API and prompt-engineering work and run the testing and quality assurance —
              and the code itself is written with AI assistant workflows. It is worth
              knowing before you read the source.
            </span>
          </p>
          <div class="about__actions" data-reveal="rise" style="--reveal-delay:250ms">
            <a class="btn" href={site.github} target="_blank" rel="noopener noreferrer">
              <Icon name="github" size={15} />
              <span>Follow on GitHub</span>
            </a>
            <span class="mono about__handle">@{site.githubHandle}</span>
          </div>
        </div>
        <ul class="about__repos" data-reveal="side-r" style="--reveal-delay:160ms">
          {
            projects.map((project) => (
              <li style={`--accent:${project.accent}`}>
                <a href={project.repo} target="_blank" rel="noopener noreferrer">
                  <span class="about__repo-icon">
                    <img src={project.icon} alt="" width="36" height="36" loading="lazy" decoding="async" />
                  </span>
                  <span class="about__repo-text">
                    <span class="about__repo-name">{project.name}</span>
                    <span class="about__repo-desc">{project.tagline}</span>
                  </span>
                  <Icon name="arrow-up-right" size={15} />
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  </main>

  <Footer />

  <button class="to-top" type="button" data-to-top aria-label="Back to top">
    <Icon name="arrow-right" size={16} />
  </button>
</BaseLayout>

<style>
  /* --------------------------------------------------------- showcase */
  .showcase {
    position: relative;
    padding-block: clamp(3rem, 7vw, 5.5rem);
    border-block: 1px solid var(--line);
    background: var(--bg-2);
    overflow: hidden;
  }
  .showcase__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: clamp(1.5rem, 3vw, 2.5rem);
  }
  .showcase__head h2 {
    margin-top: 0.9rem;
    max-width: 16ch;
  }
  .showcase__nav {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex: none;
  }
  .showcase__counter {
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    color: var(--text-3);
    margin-right: 0.4rem;
  }
  .showcase__arrow {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 999px;
    border: 1px solid var(--line-2);
    color: var(--text-2);
    background: color-mix(in srgb, var(--surface) 60%, transparent);
    backdrop-filter: blur(6px);
    transition:
      color var(--dur-1) var(--ease),
      border-color var(--dur-1) var(--ease),
      background-color var(--dur-1) var(--ease),
      transform var(--dur-1) var(--ease);
  }
  .showcase__arrow:hover {
    color: var(--text);
    border-color: var(--line-3);
    background: var(--surface-2);
  }
  .showcase__arrow:active {
    transform: scale(0.93);
  }

  .showcase__stage {
    display: grid;
  }
  .showcase__slide {
    grid-area: 1 / 1;
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: center;
    opacity: 0;
    visibility: hidden;
    transform: translateY(16px);
    transition:
      opacity var(--dur-3) var(--ease),
      transform var(--dur-4) var(--ease-out),
      visibility var(--dur-3);
  }
  .showcase__slide.is-active {
    opacity: 1;
    visibility: visible;
    transform: none;
  }
  .showcase__label {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.66rem;
    letter-spacing: 0.19em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .showcase__dot {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: var(--accent);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent) 20%, transparent);
  }
  .showcase__platform {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    color: var(--text-3);
    letter-spacing: 0.14em;
  }
  .showcase__name {
    margin-top: 0.9rem;
    font-size: clamp(1.7rem, 3vw, 2.5rem);
    letter-spacing: -0.032em;
  }
  .showcase__tagline {
    margin-top: 0.4rem;
    font-size: 1.05rem;
    color: var(--accent);
    font-weight: 500;
  }
  .showcase__body {
    margin-top: 1rem;
    color: var(--text-2);
    font-size: 0.95rem;
    line-height: 1.65;
    max-width: 52ch;
  }
  .showcase__points {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-top: 1.4rem;
  }
  .showcase__points li {
    display: flex;
    align-items: flex-start;
    gap: 0.55rem;
    font-size: 0.9rem;
    color: var(--text-2);
  }
  .showcase__points svg {
    flex: none;
    margin-top: 0.3em;
    color: var(--accent);
  }
  .showcase__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.8rem;
  }
  .showcase__art {
    position: relative;
    display: flex;
    justify-content: center;
  }
  .showcase__phone {
    width: 250px;
    transform: rotate(2deg);
  }
  .showcase__window {
    width: 100%;
    border-radius: 9px;
    overflow: hidden;
    border: 1px solid var(--line-2);
    background: var(--surface);
    box-shadow: var(--shadow-3);
    transform: rotate(-1deg);
  }
  .showcase__windowbar {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.4rem 0.6rem;
    background: linear-gradient(var(--surface-3), var(--surface-2));
    border-bottom: 1px solid var(--line);
  }
  .showcase__windowbar i {
    width: 7px;
    height: 7px;
    border-radius: 999px;
    background: var(--line-2);
  }
  .showcase__windowbar i:first-child {
    background: color-mix(in srgb, #ff5f57 60%, transparent);
  }
  .showcase__windowbar i:nth-child(2) {
    background: color-mix(in srgb, #febc2e 60%, transparent);
  }
  .showcase__windowbar i:nth-child(3) {
    background: color-mix(in srgb, #28c840 60%, transparent);
  }
  .showcase__windowbar span {
    margin-left: 0.3rem;
    font-size: 0.56rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-3);
  }
  .showcase__window img {
    width: 100%;
    height: auto;
    display: block;
  }
  .showcase__mini {
    position: absolute;
    left: -1.5rem;
    bottom: -1.5rem;
    width: 7.5rem;
    margin: 0;
    border-radius: 11px;
    overflow: hidden;
    border: 1px solid var(--line-2);
    background: var(--surface);
    box-shadow: var(--shadow-3);
    transform: rotate(-4deg);
  }
  .showcase__mini img {
    width: 100%;
    height: auto;
    display: block;
  }

  .showcase__tabs {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.5rem;
    margin-top: clamp(1.5rem, 3vw, 2.4rem);
    padding-top: clamp(1rem, 2vw, 1.5rem);
    border-top: 1px solid var(--line);
  }
  .showcase__tab {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.6rem 0.75rem;
    border-radius: var(--radius-sm);
    border: 1px solid transparent;
    text-align: left;
    opacity: 0.5;
    transition:
      opacity var(--dur-2) var(--ease),
      background-color var(--dur-2) var(--ease),
      border-color var(--dur-2) var(--ease);
  }
  .showcase__tab:hover {
    opacity: 0.85;
    background: var(--surface);
  }
  .showcase__tab.is-active {
    opacity: 1;
    border-color: color-mix(in srgb, var(--accent) 45%, transparent);
    background: color-mix(in srgb, var(--accent) 9%, transparent);
  }
  .showcase__tab-icon {
    flex: none;
    width: 1.9rem;
    height: 1.9rem;
    display: grid;
    place-items: center;
  }
  .showcase__tab-icon img {
    width: 1.7rem;
    height: 1.7rem;
    object-fit: contain;
  }
  .showcase__tab-text {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .showcase__tab-name {
    font-size: 0.87rem;
    font-weight: 560;
    letter-spacing: -0.012em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .showcase__tab-meta {
    font-size: 0.6rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-3);
  }

  /* ---------------------------------------------------- section heads */
  .section__head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.8fr);
    gap: clamp(1rem, 4vw, 3rem);
    align-items: end;
    margin-bottom: clamp(1.8rem, 4vw, 2.8rem);
  }
  .section__head h2 {
    margin-top: 0.9rem;
    max-width: 18ch;
  }
  .section__note {
    color: var(--text-2);
    font-size: 0.95rem;
    max-width: 46ch;
  }

  /* --------------------------------------------------------- filter */
  .filter {
    display: inline-flex;
    gap: 0.25rem;
    padding: 0.25rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
    margin-bottom: 1.5rem;
  }
  .filter__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.4rem 0.85rem;
    border-radius: 999px;
    font-size: 0.85rem;
    font-weight: 540;
    color: var(--text-2);
    transition:
      background-color var(--dur-2) var(--ease),
      color var(--dur-2) var(--ease);
  }
  .filter__btn span {
    font-size: 0.68rem;
    color: var(--text-3);
  }
  .filter__btn:hover {
    color: var(--text);
  }
  .filter__btn.is-active {
    background: var(--text);
    color: var(--bg);
  }
  .filter__btn.is-active span {
    color: color-mix(in srgb, var(--bg) 70%, transparent);
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(0.9rem, 1.6vw, 1.3rem);
  }
  .project-grid :global(.project-card.is-hidden) {
    display: none;
  }

  /* ------------------------------------------------------------ band */
  .band {
    position: relative;
    padding-block: clamp(3rem, 7vw, 5.5rem);
    border-block: 1px solid var(--line);
    background:
      radial-gradient(
        70% 120% at 18% 40%,
        color-mix(in srgb, #b98cff 14%, transparent) 0%,
        transparent 62%
      ),
      var(--bg-2);
    overflow: hidden;
  }
  .band__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: center;
  }
  .band__art {
    display: flex;
    justify-content: center;
  }
  .band__phones {
    display: flex;
    align-items: center;
    width: 100%;
    max-width: 28rem;
  }
  .band__phones > :global(div) {
    width: 54%;
  }
  .band__phones > :global(div):first-child {
    transform: rotate(-3deg);
    margin-right: -13%;
    z-index: 2;
  }
  .band__phones > :global(div):last-child {
    transform: rotate(3.5deg);
  }
  .band__copy h2 {
    margin-top: 0.9rem;
    max-width: 16ch;
  }
  .band__copy .lede {
    margin-top: 1.1rem;
  }
  .band__points {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-top: 1.4rem;
  }
  .band__points li {
    display: flex;
    align-items: flex-start;
    gap: 0.55rem;
    font-size: 0.92rem;
    color: var(--text-2);
  }
  .band__points svg {
    flex: none;
    margin-top: 0.3em;
    color: #b98cff;
  }
  .band__copy .btn {
    margin-top: 1.7rem;
  }

  /* ---------------------------------------------------------- strip */
  .section--strip {
    border-top: 1px solid var(--line);
  }
  .strip {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(0.8rem, 1.6vw, 1.2rem);
  }
  .strip__card {
    position: relative;
    display: block;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    overflow: hidden;
    transition:
      transform var(--dur-3) var(--ease-out),
      border-color var(--dur-2) var(--ease),
      box-shadow var(--dur-3) var(--ease-out);
  }
  .strip__card:hover {
    transform: translateY(-5px);
    border-color: color-mix(in srgb, var(--accent) 40%, var(--line));
    box-shadow: var(--shadow-2);
  }
  .strip__frame {
    display: block;
    overflow: hidden;
    background: var(--surface-2);
    aspect-ratio: 4 / 5;
  }
  .strip__frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    transition: transform var(--dur-4) var(--ease-out);
  }
  .strip__card:hover .strip__frame img {
    transform: scale(1.04);
  }
  .strip__meta {
    display: block;
    padding: 0.9rem 1rem 1rem;
  }
  .strip__name {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .strip__caption {
    display: block;
    margin-top: 0.35rem;
    font-size: 0.86rem;
    color: var(--text-2);
    line-height: 1.45;
  }
  .strip__arrow {
    position: absolute;
    top: 0.7rem;
    right: 0.7rem;
    display: grid;
    place-items: center;
    width: 1.9rem;
    height: 1.9rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--bg) 78%, transparent);
    border: 1px solid var(--line);
    color: var(--text);
    opacity: 0;
    transform: translateY(4px);
    transition:
      opacity var(--dur-2) var(--ease),
      transform var(--dur-2) var(--ease-out);
    backdrop-filter: blur(6px);
  }
  .strip__card:hover .strip__arrow,
  .strip__card:focus-visible .strip__arrow {
    opacity: 1;
    transform: none;
  }

  /* ---------------------------------------------------------- about */
  .about {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1fr) minmax(0, 0.85fr);
    gap: clamp(1.8rem, 4vw, 3.5rem);
    align-items: start;
  }
  .about__lead h2 {
    margin-top: 0.9rem;
    font-size: clamp(1.7rem, 2.6vw, 2.3rem);
    max-width: 16ch;
  }
  .about__body p {
    color: var(--text-2);
    font-size: 0.98rem;
    line-height: 1.68;
    margin-bottom: 1.1rem;
  }
  .about__method {
    display: flex;
    gap: 0.75rem;
    margin-top: 1.5rem;
    padding-top: 1.2rem;
    border-top: 1px dashed var(--line-2);
    font-size: 0.86rem;
    line-height: 1.6;
    color: var(--text-3);
  }
  .about__method-label {
    flex: none;
    font-size: 0.64rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-3);
    padding-top: 0.22rem;
  }
  .about__actions {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 1.6rem;
  }
  .about__handle {
    font-size: 0.8rem;
    color: var(--text-3);
  }
  .about__repos {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .about__repos a {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.7rem 0.85rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--surface);
    transition:
      border-color var(--dur-2) var(--ease),
      transform var(--dur-2) var(--ease-out),
      background-color var(--dur-2) var(--ease);
  }
  .about__repos a:hover {
    border-color: color-mix(in srgb, var(--accent) 40%, var(--line));
    transform: translateX(3px);
    background: var(--surface-2);
  }
  .about__repo-icon {
    flex: none;
    width: 2rem;
    height: 2rem;
    display: grid;
    place-items: center;
  }
  .about__repo-icon img {
    width: 1.75rem;
    height: 1.75rem;
    object-fit: contain;
  }
  .about__repo-text {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .about__repo-name {
    font-size: 0.9rem;
    font-weight: 560;
  }
  .about__repo-desc {
    font-size: 0.76rem;
    color: var(--text-3);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .about__repos svg {
    margin-left: auto;
    flex: none;
    color: var(--text-3);
  }

  /* --------------------------------------------------------- to top */
  .to-top {
    position: fixed;
    right: clamp(1rem, 3vw, 2rem);
    bottom: clamp(1rem, 3vw, 2rem);
    z-index: 50;
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 999px;
    border: 1px solid var(--line-2);
    background: color-mix(in srgb, var(--surface) 86%, transparent);
    color: var(--text-2);
    backdrop-filter: blur(8px);
    opacity: 0;
    transform: translateY(12px) scale(0.9);
    pointer-events: none;
    transition:
      opacity var(--dur-2) var(--ease),
      transform var(--dur-2) var(--ease-out),
      color var(--dur-1) var(--ease);
  }
  .to-top.is-visible {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }
  .to-top:hover {
    color: var(--text);
  }
  .to-top svg {
    transform: rotate(-90deg);
  }

  /* ------------------------------------------------------- responsive */
  @media (max-width: 1080px) {
    .strip {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .about {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
    .about__lead {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 980px) {
    .showcase__slide,
    .band__inner {
      grid-template-columns: minmax(0, 1fr);
    }
    .showcase__art {
      order: -1;
    }
    .showcase__mini {
      left: auto;
      right: 0;
      bottom: -1rem;
      width: 6.5rem;
    }
    .band__art {
      order: -1;
    }
    .band__phones {
      max-width: 22rem;
    }
    .project-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .section__head {
      grid-template-columns: minmax(0, 1fr);
      align-items: start;
    }
    .showcase__tabs {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 700px) {
    .strip {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .about {
      grid-template-columns: minmax(0, 1fr);
    }
    .project-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .showcase__tabs {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.4rem;
    }
    .showcase__tab {
      padding: 0.5rem 0.6rem;
      gap: 0.5rem;
    }
    .showcase__tab-icon {
      width: 1.6rem;
      height: 1.6rem;
    }
    .showcase__tab-icon img {
      width: 1.45rem;
      height: 1.45rem;
    }
    .showcase__head {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }
    .showcase__nav {
      width: 100%;
      justify-content: flex-start;
    }
    .showcase__counter {
      margin-right: auto;
    }
  }
</style>

<script>
  // Scroll-triggered reveals.
  const revealables = document.querySelectorAll<HTMLElement>('[data-reveal]');
  if ('IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.setAttribute('data-reveal', 'in');
          observer.unobserve(entry.target);
        });
      },
      { rootMargin: '0px 0px -6% 0px', threshold: 0.06 }
    );
    revealables.forEach((element) => observer.observe(element));
  } else {
    revealables.forEach((element) => element.setAttribute('data-reveal', 'in'));
  }

  // Project showcase carousel.
  const carousel = document.querySelector<HTMLElement>('[data-carousel]');
  if (carousel) {
    const slides = Array.from(carousel.querySelectorAll<HTMLElement>('[data-carousel-slide]'));
    const tabs = Array.from(carousel.querySelectorAll<HTMLButtonElement>('[data-carousel-tab]'));
    const counter = carousel.querySelector<HTMLElement>('[data-carousel-counter]');
    let index = 0;

    const show = (next: number) => {
      index = (next + slides.length) % slides.length;
      slides.forEach((slide, i) => {
        const active = i === index;
        slide.classList.toggle('is-active', active);
        slide.setAttribute('aria-hidden', String(!active));
      });
      tabs.forEach((tab, i) => {
        const active = i === index;
        tab.classList.toggle('is-active', active);
        tab.setAttribute('aria-selected', String(active));
        tab.tabIndex = active ? 0 : -1;
      });
      if (counter) {
        counter.textContent = `${String(index + 1).padStart(2, '0')} / ${String(slides.length).padStart(2, '0')}`;
      }
      const accent = slides[index]?.dataset.accent;
      if (accent) carousel.style.setProperty('--accent', accent);
    };

    slides.forEach((slide) => {
      const accent = slide.getAttribute('style')?.match(/--accent:\s*([^;]+)/)?.[1];
      if (accent) slide.dataset.accent = accent.trim();
    });
    const initial = slides[0]?.dataset.accent;
    if (initial) carousel.style.setProperty('--accent', initial);

    carousel.querySelector('[data-carousel-prev]')?.addEventListener('click', () => show(index - 1));
    carousel.querySelector('[data-carousel-next]')?.addEventListener('click', () => show(index + 1));
    tabs.forEach((tab, i) => tab.addEventListener('click', () => show(i)));

    carousel.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowRight') {
        event.preventDefault();
        show(index + 1);
      }
      if (event.key === 'ArrowLeft') {
        event.preventDefault();
        show(index - 1);
      }
    });

    let startX: number | null = null;
    carousel.addEventListener(
      'touchstart',
      (event) => {
        startX = event.changedTouches[0]?.clientX ?? null;
      },
      { passive: true }
    );
    carousel.addEventListener(
      'touchend',
      (event) => {
        if (startX === null) return;
        const delta = (event.changedTouches[0]?.clientX ?? startX) - startX;
        if (Math.abs(delta) > 56) show(index + (delta < 0 ? 1 : -1));
        startX = null;
      },
      { passive: true }
    );
  }

  // Platform filter.
  const filterRoot = document.querySelector<HTMLElement>('[data-filter]');
  const grid = document.querySelector<HTMLElement>('[data-project-grid]');
  if (filterRoot && grid) {
    const buttons = Array.from(filterRoot.querySelectorAll<HTMLButtonElement>('[data-filter-value]'));
    const cards = Array.from(grid.querySelectorAll<HTMLElement>('[data-project-card]'));
    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        const value = button.dataset.filterValue ?? 'All';
        buttons.forEach((other) => {
          const active = other === button;
          other.classList.toggle('is-active', active);
          other.setAttribute('aria-pressed', String(active));
        });
        cards.forEach((card) => {
          const show = value === 'All' || card.dataset.platform === value;
          card.classList.toggle('is-hidden', !show);
        });
      });
    });
  }

  // Back to top.
  const toTop = document.querySelector<HTMLButtonElement>('[data-to-top]');
  if (toTop) {
    const onScroll = () => toTop.classList.toggle('is-visible', window.scrollY > 900);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
    toTop.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
  }
</script>
