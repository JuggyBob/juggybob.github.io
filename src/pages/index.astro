  /* ---------------------------------------------------------- about */
  .about {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1fr) minmax(0, 0.85fr);
    gap: clamp(1.8rem, 4vw, 3.5rem);
    align-items: start;
  }
  .about__lead h2 {
    margin-top: 0.9rem;
    font-size: clamp(1.7rem, 2.6vw, 2.3rem);
    max-width: 16ch;
  }
  .about__body p {
    color: var(--text-2);
    font-size: 0.98rem;
    line-height: 1.68;
    margin-bottom: 1.1rem;
  }
  .about__actions {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 1.6rem;
  }
  .about__method {
    display: flex;
    gap: 0.75rem;
    margin-top: 1.5rem;
    padding-top: 1.2rem;
    border-top: 1px dashed var(--line-2);
    font-size: 0.86rem;
    line-height: 1.6;
    color: var(--text-3);
  }
  .about__method-label {
    flex: none;
    font-size: 0.64rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-3);
    padding-top: 0.22rem;
  }
  .about__handle {
    font-size: 0.8rem;
    color: var(--text-3);
  }
  .about__repos {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .about__repos a {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.7rem 0.85rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--surface);
    transition:
      border-color 0.25s var(--ease),
      transform 0.3s var(--ease-out),
      background-color 0.25s var(--ease);
  }
  .about__repos a:hover {
    border-color: color-mix(in srgb, var(--accent) 40%, var(--line));
    transform: translateX(3px);
    background: var(--surface-2);
  }
  .about__repo-icon {
    flex: none;
    width: 2rem;
    height: 2rem;
    display: grid;
    place-items: center;
  }
  .about__repo-icon img {
    width: 1.75rem;
    height: 1.75rem;
    object-fit: contain;
  }
  .about__repo-text {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .about__repo-name {
    font-size: 0.9rem;
    font-weight: 560;
  }
  .about__repo-desc {
    font-size: 0.76rem;
    color: var(--text-3);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .about__repos svg {
    margin-left: auto;
    flex: none;
    color: var(--text-3);
  }

  /* --------------------------------------------------------- to top */
  .to-top {
    position: fixed;
    right: clamp(1rem, 3vw, 2rem);
    bottom: clamp(1rem, 3vw, 2rem);
    z-index: 50;
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 999px;
    border: 1px solid var(--line-2);
    background: color-mix(in srgb, var(--surface) 88%, transparent);
    color: var(--text-2);
    backdrop-filter: blur(8px);
    opacity: 0;
    transform: translateY(12px) scale(0.9);
    pointer-events: none;
    transition:
      opacity 0.3s var(--ease),
      transform 0.3s var(--ease-out),
      color 0.2s var(--ease);
