  .strip__arrow {
    position: absolute;
    top: 0.7rem;
    right: 0.7rem;
    display: grid;
    place-items: center;
    width: 1.9rem;
    height: 1.9rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--bg) 78%, transparent);
    border: 1px solid var(--line);
    color: var(--text);
    opacity: 0;
    transform: translateY(4px);
    transition:
      opacity 0.3s var(--ease),
      transform 0.3s var(--ease-out);
