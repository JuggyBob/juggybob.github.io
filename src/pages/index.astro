  .feature__tab:hover {
    opacity: 0.9;
    background: var(--surface);
  }
  .feature__tab.is-active {
    opacity: 1;
    border-color: color-mix(in srgb, var(--accent) 45%, transparent);
    background: color-mix(in srgb, var(--accent) 9%, transparent);
  }
  .feature__tab-icon {
    flex: none;
    width: 1.9rem;
    height: 1.9rem;
    display: grid;
    place-items: center;
