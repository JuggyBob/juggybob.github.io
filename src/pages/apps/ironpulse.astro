---
import ProductLayout from '../../layouts/ProductLayout.astro';
import { bySlug } from '../../data/projects';

const project = bySlug('ironpulse');
---

<ProductLayout
  project={project}
  hero={{
    src: '/img/ironpulse/dashboard.webp',
    alt: 'The IronPulse home dashboard on a phone, showing today’s workout, the weekly plan, the last seven days as a heat map and the week’s training numbers.',
    caption: `IronPulse ${project.version} — Home`,
  }}
  heroFrame="phone"
/>
