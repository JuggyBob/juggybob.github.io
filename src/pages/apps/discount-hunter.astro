---
import ProductLayout from '../../layouts/ProductLayout.astro';
import { bySlug } from '../../data/projects';

const project = bySlug('discount-hunter');
---

<ProductLayout
  project={project}
  hero={{
    src: '/img/discounthunter/feed.webp',
    alt: 'The Discount Hunter deals feed showing live discounts from Steam, GOG and the Epic Games Store.',
    caption: `Discount Hunter ${project.version} — Steam · GOG · Epic`,
  }}
  heroFrame="phone"
/>
