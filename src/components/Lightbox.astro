---
import type { GalleryShot } from '../data/projects';

export interface Props {
  shots: GalleryShot[];
  id: string;
  accent?: string;
}

const { shots, id, accent } = Astro.props;
---

<div class="lightbox" data-lightbox-root style={accent ? `--accent:${accent}` : undefined}>
  <dialog class="lightbox__dialog" id={id} data-lightbox aria-label="Screenshot viewer">
    <div class="lightbox__bar">
      <span class="lightbox__count mono" data-lightbox-count></span>
      <span class="lightbox__caption" data-lightbox-caption>{shots[0]?.caption ?? ''}</span>
      <button class="lightbox__close" type="button" data-lightbox-close aria-label="Close viewer">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
          <path d="M4 4l8 8M12 4l-8 8" />
        </svg>
      </button>
    </div>
    <div class="lightbox__stage">
      <button class="lightbox__nav lightbox__nav--prev" type="button" data-lightbox-prev aria-label="Previous screenshot">
        <svg width="18" height="18" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M10 3.5 5.5 8l4.5 4.5" />
        </svg>
      </button>
      <img class="lightbox__image" data-lightbox-image
        src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" alt="" />
      <button class="lightbox__nav lightbox__nav--next" type="button" data-lightbox-next aria-label="Next screenshot">
        <svg width="18" height="18" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M6 3.5 10.5 8 6 12.5" />
        </svg>
      </button>
    </div>
  </dialog>
</div>

<style>
  .lightbox__dialog {
    position: fixed;
    inset: 0;
    margin: auto;
    border: 0;
    padding: 0;
    width: min(1120px, 94vw);
    max-width: none;
    max-height: 92vh;
    background: var(--bg-2);
    color: var(--text);
    border: 1px solid var(--line-2);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow-3);
  }
  .lightbox__dialog::backdrop {
    background: rgba(3, 4, 6, 0.84);
    backdrop-filter: blur(5px);
  }
  .lightbox__bar {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.7rem 0.9rem;
    border-bottom: 1px solid var(--line);
    background: var(--surface);
  }
  .lightbox__count {
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    color: var(--text-3);
    flex: none;
  }
  .lightbox__caption {
    font-size: 0.85rem;
    color: var(--text-2);
    flex: 1;
    min-width: 0;
  }
  .lightbox__close {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    color: var(--text-2);
    flex: none;
    transition:
      color var(--dur-1) var(--ease),
      border-color var(--dur-1) var(--ease);
  }
  .lightbox__close:hover {
    color: var(--text);
    border-color: var(--line-2);
  }
  .lightbox__stage {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0.5rem;
    padding: 0.9rem;
    background: var(--bg-2);
  }
  .lightbox__image {
    width: 100%;
    max-height: 76vh;
    object-fit: contain;
    border-radius: 6px;
    justify-self: center;
    background: #05070b;
  }
  .lightbox__nav {
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    color: var(--text-2);
    background: var(--surface);
    transition:
      color var(--dur-1) var(--ease),
      border-color var(--dur-1) var(--ease),
      transform var(--dur-1) var(--ease);
  }
  .lightbox__nav:hover {
    color: var(--text);
    border-color: var(--line-2);
  }
  .lightbox__nav:active {
    transform: scale(0.93);
  }
  .lightbox__nav[hidden] {
    display: none;
  }

  @media (max-width: 640px) {
    .lightbox__stage {
      grid-template-columns: 1fr;
      gap: 0.7rem;
    }
    .lightbox__nav {
      justify-self: center;
    }
    .lightbox__image {
      max-height: 58vh;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-lightbox-root]').forEach((root) => {
    const dialog = root.querySelector<HTMLDialogElement>('[data-lightbox]');
    const image = root.querySelector<HTMLImageElement>('[data-lightbox-image]');
    const caption = root.querySelector<HTMLElement>('[data-lightbox-caption]');
    const count = root.querySelector<HTMLElement>('[data-lightbox-count]');
    if (!dialog || !image || !caption || !count) return;

    const triggers = Array.from(
      root.querySelectorAll<HTMLButtonElement>('[data-lightbox-open]')
    );
    const shots = triggers.map((button) => {
      const img = button.querySelector('img');
      const cap = button.getAttribute('data-lightbox-caption');
      const src = button.getAttribute('data-lightbox-src');
      const alt = button.getAttribute('data-lightbox-alt');
      return {
        src: src || img?.currentSrc || img?.src || '',
        alt: alt || img?.alt || '',
        caption: cap ?? img?.alt ?? '',
      };
    });
    if (!shots.length) return;

    let index = 0;

    const render = () => {
      const shot = shots[index];
      if (!shot) return;
      image.src = shot.src;
      image.alt = shot.alt;
      caption.textContent = shot.caption;
      count.textContent =
        shots.length > 1
          ? `${String(index + 1).padStart(2, '0')} / ${String(shots.length).padStart(2, '0')}`
          : '';
      const single = shots.length === 1;
      root.querySelector<HTMLElement>('[data-lightbox-prev]')?.toggleAttribute('hidden', single);
      root.querySelector<HTMLElement>('[data-lightbox-next]')?.toggleAttribute('hidden', single);
    };

    const open = (start: number) => {
      index = start;
      render();
      if (typeof dialog.showModal === 'function') dialog.showModal();
      else dialog.setAttribute('open', '');
    };

    const step = (delta: number) => {
      if (shots.length < 2) return;
      index = (index + delta + shots.length) % shots.length;
      render();
    };

    triggers.forEach((button, i) =>
      button.addEventListener('click', (event) => {
        event.preventDefault();
        event.stopPropagation();
        open(i);
      })
    );
    root.querySelector('[data-lightbox-prev]')?.addEventListener('click', () => step(-1));
    root.querySelector('[data-lightbox-next]')?.addEventListener('click', () => step(1));
    root.querySelector('[data-lightbox-close]')?.addEventListener('click', () => dialog.close());

    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });

    dialog.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowRight') {
        event.preventDefault();
        step(1);
      }
      if (event.key === 'ArrowLeft') {
        event.preventDefault();
        step(-1);
      }
    });

    let startX: number | null = null;
    dialog.addEventListener(
      'touchstart',
      (event) => {
        startX = event.changedTouches[0]?.clientX ?? null;
      },
      { passive: true }
    );
    dialog.addEventListener(
      'touchend',
      (event) => {
        if (startX === null) return;
        const delta = (event.changedTouches[0]?.clientX ?? startX) - startX;
        if (Math.abs(delta) > 48) step(delta < 0 ? 1 : -1);
        startX = null;
      },
      { passive: true }
    );
  });
</script>
