---
export interface Props {
  src: string;
  alt: string;
  /** Render the punch-hole camera. */
  camera?: boolean;
  class?: string;
  loading?: 'lazy' | 'eager';
  sizes?: string;
  /** Maximum rendered width of the whole device, including the bezel. */
  width?: string;
  /** Slight tilt applied to the device, in degrees. */
  tilt?: number;
}

const {
  src,
  alt,
  camera = true,
  class: className = '',
  loading = 'lazy',
  sizes = '(max-width: 720px) 62vw, 340px',
  width,
  tilt = 0,
} = Astro.props;
---

<div
  class={`phone ${className}`}
  style={`${width ? `max-width:${width};` : ''}${tilt ? `--tilt:${tilt}deg;` : ''}`}
>
  <div class="phone__body">
    {
      camera && (
        <span class="phone__camera" aria-hidden="true">
          <span class="phone__lens" />
        </span>
      )
    }
    <div class="phone__screen">
      <img
        src={src}
        alt={alt}
        loading={loading}
        decoding="async"
        sizes={sizes}
        width="900"
        height="2000"
      />
      <span class="phone__glare" aria-hidden="true"></span>
    </div>
  </div>
</div>

<style>
  .phone {
    position: relative;
    width: 100%;
    max-width: 320px;
    margin-inline: auto;
    transform: rotate(var(--tilt, 0deg));
    transform-origin: 50% 60%;
    transition: transform var(--dur-3) var(--ease-out);
  }
  .phone__body {
    position: relative;
    border-radius: 13%/6.2%;
    padding: 3px;
    background: linear-gradient(
      145deg,
      color-mix(in srgb, var(--text) 26%, transparent) 0%,
      color-mix(in srgb, var(--surface-3) 92%, transparent) 26%,
      color-mix(in srgb, var(--text) 10%, transparent) 52%,
      color-mix(in srgb, var(--surface-3) 96%, transparent) 78%,
      color-mix(in srgb, var(--text) 22%, transparent) 100%
    );
    box-shadow:
      0 0 0 1px color-mix(in srgb, var(--text) 8%, transparent),
      var(--shadow-3);
  }
  .phone__screen {
    position: relative;
    border-radius: 12.4%/5.8%;
    overflow: hidden;
    background: #05070b;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.06);
  }
  .phone__screen img {
    width: 100%;
    height: auto;
    display: block;
  }
  /* A soft diagonal sheen so the glass reads as glass. */
  .phone__glare {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(
      118deg,
      rgba(255, 255, 255, 0.13) 0%,
      rgba(255, 255, 255, 0.03) 26%,
      transparent 46%
    );
    mix-blend-mode: screen;
    opacity: 0.55;
  }
  [data-theme='light'] .phone__glare {
    opacity: 0.3;
  }
  .phone__camera {
    position: absolute;
    top: 13px;
    left: 50%;
    transform: translateX(-50%);
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: #04060a;
    box-shadow: 0 0 0 1.5px rgba(255, 255, 255, 0.1);
    z-index: 3;
  }
  .phone__lens {
    position: absolute;
    inset: 1.5px;
    border-radius: 999px;
    background: radial-gradient(circle at 32% 30%, #33405e, #04060a 72%);
  }
</style>
