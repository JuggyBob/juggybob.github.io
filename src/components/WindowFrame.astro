---
export interface Props {
  src: string;
  alt: string;
  title?: string;
  class?: string;
  loading?: 'lazy' | 'eager';
  width?: string;
}

const {
  src,
  alt,
  title = 'CodeScope',
  class: className = '',
  loading = 'lazy',
  width,
} = Astro.props;
---

<div class={`window ${className}`} style={width ? `max-width:${width}` : undefined}>
  <div class="window__bar">
    <span class="window__dots" aria-hidden="true">
      <i></i><i></i><i></i>
    </span>
    <span class="window__title mono">{title}</span>
    <span class="window__spacer" aria-hidden="true"></span>
  </div>
  <div class="window__body">
    <img src={src} alt={alt} loading={loading} decoding="async" width="1800" height="976" />
  </div>
</div>

<style>
  .window {
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid var(--line-2);
    background: var(--surface);
    box-shadow: var(--shadow-lg);
  }
  .window__bar {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0.55rem 0.8rem;
    background: var(--surface-2);
    border-bottom: 1px solid var(--line);
  }
  .window__dots {
    display: inline-flex;
    gap: 0.38rem;
  }
  .window__dots i {
    width: 9px;
    height: 9px;
    border-radius: 999px;
    background: var(--line-2);
  }
  .window__title {
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    color: var(--text-3);
  }
  .window__spacer {
    flex: 1;
  }
  .window__body img {
    width: 100%;
    height: auto;
    display: block;
  }
</style>
