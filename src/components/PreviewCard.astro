---
import Icon from './Icon.astro';
import type { Project } from '../data/projects';

export interface Props {
  project: Project;
  /** Shows a small screenshot band under the copy. */
  shot?: boolean;
  /** Which part of the screenshot the band shows. */
  focus?: string;
  class?: string;
}

const { project, shot = true, focus = 'top center', class: className = '' } = Astro.props;
---

<a
  class={`pcard ${className}`}
  href={`/apps/${project.slug}/`}
  style={`--accent:${project.accent};--accent-ink:${project.accentInk}`}
>
  <span class="pcard__head">
    <span class="pcard__icon">
      <img src={project.icon} alt="" width="40" height="40" loading="lazy" decoding="async" />
    </span>
    <span class="pcard__ident">
      <span class="pcard__name">{project.name}</span>
      <span class="pcard__platform mono">
        <Icon name={project.platform === 'Android' ? 'android' : 'windows'} size={12} />
        {project.platform}
      </span>
    </span>
    <span class="pcard__arrow" aria-hidden="true">
      <Icon name="arrow-up-right" size={15} />
    </span>
  </span>

  <span class="pcard__summary">{project.tagline}</span>

  {
    shot && (
      <span class="pcard__shot">
        <img
          src={project.preview.src}
          alt=""
          loading="lazy"
          decoding="async"
          width="900"
          height="2000"
          style={`--focus:${focus}`}
        />
        <span class="pcard__sheen" aria-hidden="true"></span>
      </span>
    )
  }

  <span class="pcard__cta">
    <span>Open project page</span>
    <Icon name="arrow-right" size={14} />
  </span>
</a>

<style>
  .pcard {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background:
      radial-gradient(
        130% 100% at 100% 0%,
        color-mix(in srgb, var(--accent) 13%, transparent) 0%,
        transparent 60%
      ),
      var(--surface);
    box-shadow: var(--shadow-2);
    overflow: hidden;
    transition:
      transform var(--dur-3) var(--ease-out),
      border-color var(--dur-2) var(--ease),
      box-shadow var(--dur-3) var(--ease-out);
  }
  .pcard:hover,
  .pcard:focus-visible {
    transform: translateY(-3px);
    border-color: color-mix(in srgb, var(--accent) 45%, var(--line));
    box-shadow: var(--shadow-3);
  }
  .pcard__head {
    display: flex;
    align-items: center;
    gap: 0.7rem;
  }
  .pcard__icon {
    flex: none;
    width: 2.4rem;
    height: 2.4rem;
    display: grid;
    place-items: center;
    border-radius: 12px;
    background: color-mix(in srgb, var(--accent) 13%, var(--surface-2));
    border: 1px solid color-mix(in srgb, var(--accent) 25%, transparent);
  }
  .pcard__icon img {
    width: 1.5rem;
    height: 1.5rem;
    object-fit: contain;
  }
  .pcard__ident {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    min-width: 0;
  }
  .pcard__name {
    font-size: 0.98rem;
    font-weight: 600;
    letter-spacing: -0.018em;
  }
  .pcard__platform {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.6rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-3);
  }
  .pcard__arrow {
    margin-left: auto;
    display: grid;
    place-items: center;
    width: 1.8rem;
    height: 1.8rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    color: var(--text-3);
    transition:
      color var(--dur-2) var(--ease),
      border-color var(--dur-2) var(--ease),
      transform var(--dur-2) var(--ease-out);
  }
  .pcard:hover .pcard__arrow {
    color: var(--accent);
    border-color: color-mix(in srgb, var(--accent) 45%, transparent);
    transform: translate(2px, -2px);
  }
  .pcard__summary {
    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--text-2);
  }
  .pcard__shot {
    position: relative;
    display: block;
    height: 6.25rem;
    border-radius: 9px;
    overflow: hidden;
    border: 1px solid var(--line);
    background: var(--surface-2);
  }
  .pcard__shot img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--focus, top center);
    transition: transform var(--dur-4) var(--ease-out);
  }
  .pcard:hover .pcard__shot img {
    transform: scale(1.05);
  }
  .pcard__sheen {
    position: absolute;
    inset: 0;
    background: linear-gradient(200deg, rgba(255, 255, 255, 0.07), transparent 46%);
    pointer-events: none;
  }
  .pcard__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8rem;
    font-weight: 560;
    color: var(--accent);
  }
  .pcard__cta svg {
    transition: transform var(--dur-2) var(--ease-out);
  }
  .pcard:hover .pcard__cta svg {
    transform: translateX(4px);
  }
</style>
