---
import Lightbox from './Lightbox.astro';
import type { GalleryShot } from '../data/projects';

export interface Props {
  shots: GalleryShot[];
  id: string;
  accent?: string;
}

const { shots, id, accent } = Astro.props;
---

<div class="gallery" data-gallery style={accent ? `--accent:${accent}` : undefined}>
  <ul class="gallery__grid">
    {
      shots.map((shot) => (
        <li class="gallery__item">
          <button
            class="gallery__button"
            type="button"
            data-lightbox-open
            data-lightbox-caption={shot.caption}
            aria-label={`Open ${shot.caption}`}
          >
            <span class="gallery__frame">
              <img
                src={shot.src}
                alt={shot.alt}
                loading="lazy"
                decoding="async"
                width="900"
                height="2000"
              />
            </span>
            <span class="gallery__caption">{shot.caption}</span>
          </button>
        </li>
      ))
    }
  </ul>

  <Lightbox shots={shots} id={`${id}-lightbox`} accent={accent} />
</div>

<style>
  .gallery__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(215px, 1fr));
    gap: clamp(0.7rem, 1.4vw, 1.1rem);
  }
  .gallery__button {
    display: block;
    width: 100%;
    text-align: left;
    border-radius: var(--radius-sm);
    overflow: hidden;
    border: 1px solid var(--line);
    background: var(--surface);
    transition:
      transform var(--dur-3) var(--ease-out),
      border-color var(--dur-2) var(--ease),
      box-shadow var(--dur-3) var(--ease-out);
  }
  .gallery__button:hover,
  .gallery__button:focus-visible {
    transform: translateY(-4px);
    border-color: var(--line-2);
    box-shadow: var(--shadow-2);
  }
  .gallery__frame {
    display: block;
    overflow: hidden;
    background: var(--surface-2);
    aspect-ratio: 9 / 19;
  }
  .gallery__frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    transition: transform var(--dur-4) var(--ease-out);
  }
  .gallery__button:hover .gallery__frame img {
    transform: scale(1.045);
  }
  .gallery__caption {
    display: block;
    padding: 0.7rem 0.8rem 0.8rem;
    font-size: 0.78rem;
    line-height: 1.4;
    color: var(--text-2);
  }

  @media (max-width: 520px) {
    .gallery__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.6rem;
    }
    .gallery__caption {
      padding: 0.55rem 0.6rem 0.65rem;
      font-size: 0.72rem;
    }
  }
</style>
