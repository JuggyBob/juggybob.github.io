---
export interface Props {
  name:
    | 'arrow-right'
    | 'arrow-up-right'
    | 'external'
    | 'github'
    | 'android'
    | 'windows'
    | 'sun'
    | 'moon'
    | 'menu'
    | 'close'
    | 'chevron-left'
    | 'chevron-right'
    | 'download'
    | 'code'
    | 'check'
    | 'sparkle';
