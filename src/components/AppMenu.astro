---
import Icon from './Icon.astro';
import { projects } from '../data/projects';

interface Props {
  /** Anchor for the "all projects" link. */
  projectsHref?: string;
}

const { projectsHref = '/#apps' } = Astro.props;
---

<div class="appmenu" data-appmenu>
  <button
    class="burger"
    type="button"
    data-appmenu-toggle
    aria-expanded="false"
    aria-controls="appmenu-panel"
    aria-label="Open the application directory"
  >
    <span class="burger__bars" aria-hidden="true">
      <i></i><i></i><i></i>
    </span>
  </button>

  <div class="appmenu__panel" id="appmenu-panel" data-appmenu-panel hidden>
    <div class="appmenu__head">
      <p class="appmenu__eyebrow mono">Application directory</p>
      <p class="appmenu__note">Four independent apps — three for Android, one for Windows.</p>
    </div>

    <ul class="appmenu__list">
      {
        projects.map((project) => (
          <li>
            <a
              class={`appmenu__item ${project.badge === 'Main project' ? 'appmenu__item--lead' : ''}`}
              href={`/apps/${project.slug}/`}
              style={`--accent:${project.accent};--accent-ink:${project.accentInk}`}
            >
              <span class="appmenu__icon">
                <img src={project.icon} alt="" width="42" height="42" loading="lazy" decoding="async" />
              </span>

              <span class="appmenu__body">
                <span class="appmenu__row">
                  <span class="appmenu__name">{project.name}</span>
                  {project.badge && <span class="appmenu__badge mono">{project.badge}</span>}
                  <span class="appmenu__platform mono">
                    <Icon
                      name={project.platform === 'Android' ? 'android' : 'windows'}
                      size={12}
                    />
                    {project.platform}
                  </span>
                </span>
                <span class="appmenu__summary">{project.tagline}</span>
                <span class="appmenu__points">
                  {project.menuHighlights.map((point) => (
                    <span class="appmenu__point">
                      <i aria-hidden="true" />
                      {point}
                    </span>
                  ))}
                </span>
              </span>

              <span class="appmenu__thumb" aria-hidden="true">
                <img
                  src={project.preview.src}
                  alt=""
                  loading="lazy"
                  decoding="async"
                  width="900"
                  height="2000"
                />
              </span>
            </a>
          </li>
        ))
      }
    </ul>

    <div class="appmenu__foot">
      <a class="appmenu__foot-link" href={projectsHref}>
        <span>All projects</span>
        <Icon name="arrow-right" size={13} />
      </a>
      <a class="appmenu__foot-link" href="/#gallery">
        <span>Screens</span>
        <Icon name="arrow-right" size={13} />
      </a>
      <a class="appmenu__foot-link" href="/#about">
        <span>About</span>
        <Icon name="arrow-right" size={13} />
      </a>
      <a
        class="appmenu__foot-link appmenu__foot-link--ext"
        href="https://github.com/JuggyBob"
        target="_blank"
        rel="noopener noreferrer"
      >
        <Icon name="github" size={13} />
        <span>GitHub</span>
      </a>
    </div>
  </div>
</div>

<style>
  .appmenu {
    position: relative;
  }

  /* ------------------------------------------------------------- trigger */
  .burger {
    display: grid;
    place-items: center;
    width: 2.35rem;
    height: 2.35rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    color: var(--text-2);
    transition:
      color var(--dur-1) var(--ease),
      border-color var(--dur-1) var(--ease),
      background-color var(--dur-1) var(--ease);
  }
  .burger:hover {
    color: var(--text);
    border-color: var(--line-2);
    background: var(--surface-2);
  }
  .burger__bars {
    position: relative;
    display: block;
    width: 15px;
    height: 11px;
  }
  .burger__bars i {
    position: absolute;
    left: 0;
    height: 1.6px;
    width: 100%;
    border-radius: 2px;
    background: currentColor;
    transition:
      transform var(--dur-2) var(--ease-out),
      opacity var(--dur-1) var(--ease),
      width var(--dur-2) var(--ease-out);
  }
  .burger__bars i:nth-child(1) {
    top: 0;
  }
  .burger__bars i:nth-child(2) {
    top: 4.7px;
    width: 72%;
  }
  .burger__bars i:nth-child(3) {
    top: 9.4px;
  }
  .burger[aria-expanded='true'] {
    color: var(--text);
    border-color: var(--line-2);
  }
  .burger[aria-expanded='true'] .burger__bars i:nth-child(1) {
    transform: translateY(4.7px) rotate(45deg);
  }
  .burger[aria-expanded='true'] .burger__bars i:nth-child(2) {
    opacity: 0;
    transform: scaleX(0.2);
  }
  .burger[aria-expanded='true'] .burger__bars i:nth-child(3) {
    transform: translateY(-4.7px) rotate(-45deg);
  }

  /* --------------------------------------------------------------- panel */
  .appmenu__panel {
    position: absolute;
    top: calc(100% + 0.6rem);
    right: 0;
    z-index: 70;
    width: min(32rem, calc(100vw - 2 * var(--gutter)));
    padding: 0.75rem;
    border: 1px solid var(--line-2);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: var(--shadow-3);
    transform-origin: top right;
    animation: menu-in var(--dur-2) var(--ease-out) both;
  }
  .appmenu__panel[hidden] {
    display: none;
  }
  @keyframes menu-in {
    from {
      opacity: 0;
      transform: translateY(-8px) scale(0.985);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .appmenu__head {
    padding: 0.25rem 0.45rem 0.7rem;
    border-bottom: 1px solid var(--line);
    margin-bottom: 0.4rem;
  }
  .appmenu__eyebrow {
    font-size: 0.6rem;
    letter-spacing: 0.19em;
    text-transform: uppercase;
    color: var(--text-3);
  }
  .appmenu__note {
    margin-top: 0.25rem;
    font-size: 0.8rem;
    color: var(--text-2);
  }

  .appmenu__list {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .appmenu__item {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.8rem;
    padding: 0.55rem 0.65rem;
    border-radius: var(--radius-sm);
    border: 1px solid transparent;
    transition:
      background-color var(--dur-2) var(--ease),
      border-color var(--dur-2) var(--ease),
      transform var(--dur-2) var(--ease-out);
  }
  .appmenu__item:hover,
  .appmenu__item:focus-visible {
    background: color-mix(in srgb, var(--accent) 9%, transparent);
    border-color: color-mix(in srgb, var(--accent) 30%, transparent);
    transform: translateX(2px);
  }
  .appmenu__item--lead {
    background: color-mix(in srgb, var(--accent) 7%, transparent);
    border-color: color-mix(in srgb, var(--accent) 24%, transparent);
  }
  .appmenu__icon {
    flex: none;
    width: 2.25rem;
    height: 2.25rem;
    display: grid;
    place-items: center;
    border-radius: 11px;
    background: color-mix(in srgb, var(--accent) 14%, var(--surface-2));
    border: 1px solid color-mix(in srgb, var(--accent) 24%, transparent);
  }
  .appmenu__icon img {
    width: 1.45rem;
    height: 1.45rem;
    object-fit: contain;
  }
  .appmenu__body {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    min-width: 0;
  }
  .appmenu__row {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    flex-wrap: wrap;
  }
  .appmenu__name {
    font-size: 0.92rem;
    font-weight: 600;
    letter-spacing: -0.018em;
  }
  .appmenu__badge {
    font-size: 0.53rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 0.13rem 0.42rem;
    border-radius: 999px;
    color: var(--accent-ink);
    background: var(--accent);
    font-weight: 600;
  }
  .appmenu__platform {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.56rem;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--text-3);
  }
  .appmenu__summary {
    font-size: 0.8rem;
    color: var(--text-2);
    line-height: 1.4;
  }
  .appmenu__points {
    display: flex;
    flex-wrap: wrap;
    gap: 0.15rem 0.8rem;
    margin-top: 0.15rem;
  }
  .appmenu__point {
    display: inline-flex;
    align-items: center;
    gap: 0.32rem;
    font-size: 0.72rem;
    color: var(--text-3);
  }
  .appmenu__point i {
    width: 3.5px;
    height: 3.5px;
    border-radius: 999px;
    background: var(--accent);
    flex: none;
  }
  .appmenu__thumb {
    flex: none;
    width: 4rem;
    height: 3.1rem;
    border-radius: 7px;
    overflow: hidden;
    border: 1px solid var(--line);
    background: var(--surface-2);
    transition:
      transform var(--dur-3) var(--ease-out),
      border-color var(--dur-2) var(--ease);
  }
  .appmenu__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }
  .appmenu__item:hover .appmenu__thumb,
  .appmenu__item:focus-visible .appmenu__thumb {
    transform: scale(1.06);
    border-color: color-mix(in srgb, var(--accent) 45%, transparent);
  }

  .appmenu__foot {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem;
    margin-top: 0.5rem;
    padding-top: 0.6rem;
    border-top: 1px solid var(--line);
  }
  .appmenu__foot-link {
    display: inline-flex;
    align-items: center;
    gap: 0.32rem;
    padding: 0.35rem 0.55rem;
    border-radius: 999px;
    font-size: 0.76rem;
    color: var(--text-2);
    transition:
      color var(--dur-1) var(--ease),
      background-color var(--dur-1) var(--ease);
  }
  .appmenu__foot-link:hover {
    color: var(--text);
    background: var(--surface-2);
  }
  .appmenu__foot-link--ext {
    margin-left: auto;
  }

  @media (max-width: 560px) {
    .appmenu__panel {
      position: fixed;
      top: 4.6rem;
      left: 0.75rem;
      right: 0.75rem;
      width: auto;
      max-height: calc(100svh - 6rem);
      overflow-y: auto;
      transform-origin: top center;
      animation: menu-in-mobile var(--dur-2) var(--ease-out) both;
    }
    @keyframes menu-in-mobile {
      from {
        opacity: 0;
        transform: translateY(-10px) scale(0.985);
      }
      to {
        opacity: 1;
        transform: none;
      }
    }
    .appmenu__thumb {
      display: none;
    }
    .appmenu__item {
      grid-template-columns: auto minmax(0, 1fr);
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-appmenu]').forEach((root) => {
    const toggle = root.querySelector<HTMLButtonElement>('[data-appmenu-toggle]');
    const panel = root.querySelector<HTMLElement>('[data-appmenu-panel]');
    if (!toggle || !panel) return;

    const setOpen = (open: boolean, restoreFocus = false) => {
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute(
        'aria-label',
        open ? 'Close the application directory' : 'Open the application directory'
      );
      panel.hidden = !open;
      if (open) {
        panel.removeAttribute('inert');
        const first = panel.querySelector<HTMLElement>('.appmenu__item');
        first?.focus({ preventScroll: true });
      } else {
        panel.setAttribute('inert', '');
        if (restoreFocus) toggle.focus({ preventScroll: true });
      }
    };

    panel.setAttribute('inert', '');
    setOpen(false);

    toggle.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') !== 'true';
      setOpen(open);
    });

    document.addEventListener('click', (event) => {
      if (toggle.getAttribute('aria-expanded') !== 'true') return;
      const target = event.target as Node;
      if (root.contains(target)) return;
      setOpen(false);
    });

    document.addEventListener('keydown', (event) => {
      if (toggle.getAttribute('aria-expanded') !== 'true') return;
      if (event.key === 'Escape') {
        event.preventDefault();
        setOpen(false, true);
      }
    });

    panel.addEventListener('focusout', (event) => {
      const next = event.relatedTarget as Node | null;
      if (next && (root.contains(next) || toggle.contains(next))) return;
      if (toggle.getAttribute('aria-expanded') !== 'true') return;
      setOpen(false);
    });
  });
</script>
