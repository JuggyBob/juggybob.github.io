---
import Lightbox from './Lightbox.astro';

export interface Props {
  src: string;
  alt: string;
  title?: string;
  caption?: string;
  /** Suggests the interesting region on small screens (percentages). */
  focus?: string;
  accent?: string;
  class?: string;
}

const {
  src,
  alt,
  title = 'CodeScope',
  caption,
  focus = 'top center',
  accent,
  class: className = '',
} = Astro.props;
---

<div class={`dshot ${className}`} data-lightbox-root style={accent ? `--accent:${accent}` : undefined}>
  <div class="dshot__window">
    <div class="dshot__bar">
      <span class="dshot__dots" aria-hidden="true"><i></i><i></i><i></i></span>
      <span class="dshot__title mono">{title}</span>
    </div>
    <div class="dshot__body">
      <img
        class="dshot__img"
        src={src}
        alt={alt}
        loading="lazy"
        decoding="async"
        style={`--focus:${focus}`}
        width="1800"
        height="976"
      />
      <button
        class="dshot__expand"
        type="button"
        data-lightbox-open
        data-lightbox-src={src}
        data-lightbox-alt={alt}
        data-lightbox-caption={caption ?? alt}
        aria-label="Open the full screenshot"
      >
        <svg width="15" height="15" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M9 3H13V7M13 3 7.5 8.5M11.5 9.5V13H3V4.5H6.5" />
        </svg>
      </button>
    </div>
  </div>
  {caption && <p class="dshot__caption">{caption}</p>}

  <Lightbox shots={[{ src, alt, caption: caption ?? alt }]} id={`dshot-${title}`} accent={accent} />
</div>

<style>
  .dshot__window {
    border-radius: 10px;
    overflow: hidden;
    border: 1px solid var(--line-2);
    background: var(--surface);
    box-shadow: var(--shadow-3);
  }
  .dshot__bar {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.45rem 0.7rem;
    background: linear-gradient(var(--surface-3), var(--surface-2));
    border-bottom: 1px solid var(--line);
  }
  .dshot__dots {
    display: inline-flex;
    gap: 0.34rem;
    flex: none;
  }
  .dshot__dots i {
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: var(--line-2);
  }
  .dshot__dots i:first-child {
    background: color-mix(in srgb, #ff5f57 60%, transparent);
  }
  .dshot__dots i:nth-child(2) {
    background: color-mix(in srgb, #febc2e 60%, transparent);
  }
  .dshot__dots i:last-child {
    background: color-mix(in srgb, #28c840 60%, transparent);
  }
  .dshot__title {
    font-size: 0.64rem;
    letter-spacing: 0.09em;
    color: var(--text-3);
  }
  .dshot__body {
    position: relative;
    background: #05070b;
  }
  .dshot__img {
    width: 100%;
    height: auto;
    display: block;
  }
  .dshot__expand {
    position: absolute;
    top: 0.6rem;
    right: 0.6rem;
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 999px;
    border: 1px solid var(--line-2);
    background: color-mix(in srgb, #05070b 70%, transparent);
    color: #dfe3ea;
    opacity: 0;
    transform: scale(0.9);
    backdrop-filter: blur(6px);
    transition:
      opacity var(--dur-2) var(--ease),
      transform var(--dur-2) var(--ease-out);
  }
  .dshot:hover .dshot__expand,
  .dshot__expand:focus-visible {
    opacity: 1;
    transform: none;
  }
  .dshot__caption {
    margin-top: 0.7rem;
    font-size: 0.8rem;
    color: var(--text-3);
    line-height: 1.5;
  }

  /* On a phone a wide desktop screenshot cannot be read at full width, so it is
     cropped to its most informative band and can be opened full screen. */
  @media (max-width: 720px) {
    .dshot__body {
      aspect-ratio: 16 / 10;
      overflow: hidden;
    }
    .dshot__img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: var(--focus);
    }
    .dshot__expand {
      opacity: 1;
      transform: none;
    }
  }
</style>
