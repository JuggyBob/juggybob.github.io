---
import Icon from './Icon.astro';
import AppMenu from './AppMenu.astro';
import { navLinks, site } from '../data/site';
---

<header class="site-header" data-header>
  <div class="site-header__progress" aria-hidden="true"><span data-progress></span></div>

  <div class="wrap wrap-wide site-header__inner">
    <a class="brand" href="/" aria-label="JuggyBob — home">
      <span class="brand__mark" aria-hidden="true">
        <svg viewBox="0 0 32 32" width="30" height="30" fill="none">
          <rect x="1" y="1" width="30" height="30" rx="9" class="brand__plate" />
          <path
            d="M6 16h4l2.2-5.4L15.4 22l2.6-12 2.3 6h5.7"
            class="brand__pulse"
            stroke-width="2.1"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </span>
      <span class="brand__text">JuggyBob</span>
    </a>

    <nav class="site-nav" aria-label="Primary">
      <ul>
        {
          navLinks.map((link) => (
            <li>
              <a class="site-nav__link" href={link.href}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="site-header__actions">
      <a
        class="icon-btn icon-btn--gh"
        href={`${site.github}?tab=repositories`}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="JuggyBob on GitHub"
      >
        <Icon name="github" size={16} />
      </a>
      <button class="icon-btn" data-theme-toggle type="button" aria-label="Switch colour theme">
        <span class="icon-btn__sun"><Icon name="sun" size={17} /></span>
        <span class="icon-btn__moon"><Icon name="moon" size={17} /></span>
      </button>
      <AppMenu />
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 60;
    background: color-mix(in srgb, var(--bg) 74%, transparent);
    backdrop-filter: saturate(160%) blur(16px);
    -webkit-backdrop-filter: saturate(160%) blur(16px);
    border-bottom: 1px solid transparent;
    transition:
      border-color var(--dur-3) var(--ease),
      background-color var(--dur-3) var(--ease);
  }
  .site-header.is-stuck {
    border-bottom-color: var(--line);
    background: color-mix(in srgb, var(--bg) 90%, transparent);
  }
  .site-header__progress {
    position: absolute;
    inset: 0 0 auto;
    height: 2px;
    overflow: hidden;
  }
  .site-header__progress span {
    display: block;
    height: 100%;
    width: 100%;
    transform: scaleX(var(--scroll-progress, 0));
    transform-origin: 0 50%;
    background: linear-gradient(90deg, var(--brand), var(--brand-2));
    opacity: 0;
    transition: opacity var(--dur-2) var(--ease);
  }
  .site-header.is-stuck .site-header__progress span {
    opacity: 1;
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    height: 4.5rem;
    transition: height var(--dur-3) var(--ease);
  }
  .site-header.is-stuck .site-header__inner {
    height: 3.9rem;
  }

  .brand {
    font-size: 1.05rem;
    flex: none;
  }

  .site-nav {
    margin-left: auto;
  }
  .site-nav ul {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }
  .site-nav__link {
    display: inline-flex;
    align-items: center;
    padding: 0.45rem 0.8rem;
    border-radius: 999px;
    font-size: 0.88rem;
    font-weight: 520;
    color: var(--text-2);
    transition:
      color var(--dur-1) var(--ease),
      background-color var(--dur-1) var(--ease);
  }
  .site-nav__link:hover {
    color: var(--text);
    background: var(--surface-2);
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .icon-btn {
    display: grid;
    place-items: center;
    width: 2.3rem;
    height: 2.3rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    color: var(--text-2);
    transition:
      color var(--dur-1) var(--ease),
      border-color var(--dur-1) var(--ease),
      background-color var(--dur-1) var(--ease),
      transform var(--dur-1) var(--ease);
  }
  .icon-btn:hover {
    color: var(--text);
    border-color: var(--line-2);
    background: var(--surface-2);
  }
  .icon-btn:active {
    transform: scale(0.94);
  }

  .icon-btn__sun,
  .icon-btn__moon {
    grid-area: 1 / 1;
    display: grid;
    place-items: center;
    transition:
      opacity var(--dur-3) var(--ease),
      transform var(--dur-3) var(--ease-out);
  }
  :global([data-theme='dark']) .icon-btn__sun {
    opacity: 0;
    transform: rotate(-60deg) scale(0.5);
  }
  :global([data-theme='dark']) .icon-btn__moon {
    opacity: 1;
    transform: none;
  }
  :global([data-theme='light']) .icon-btn__sun {
    opacity: 1;
    transform: none;
  }
  :global([data-theme='light']) .icon-btn__moon {
    opacity: 0;
    transform: rotate(60deg) scale(0.5);
  }

  @media (max-width: 860px) {
    .site-nav {
      display: none;
    }
    .icon-btn--gh {
      display: none;
    }
    .site-header__inner {
      height: 4rem;
    }
    .site-header.is-stuck .site-header__inner {
      height: 3.6rem;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  if (header) {
    let ticking = false;
    const update = () => {
      const y = window.scrollY;
      header.classList.toggle('is-stuck', y > 12);
      const max = document.documentElement.scrollHeight - window.innerHeight;
      const progress = max > 0 ? Math.min(1, y / max) : 0;
      document.documentElement.style.setProperty('--scroll-progress', progress.toFixed(4));
      ticking = false;
    };
    update();
    window.addEventListener(
      'scroll',
      () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(update);
      },
      { passive: true }
    );
    window.addEventListener('resize', update, { passive: true });
  }

  const toggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  if (toggle) {
    toggle.addEventListener('click', () => {
      const next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
      document.documentElement.dataset.theme = next;
      try {
        localStorage.setItem('jb-theme', next);
      } catch {
        /* ignore */
      }
    });
  }
</script>
