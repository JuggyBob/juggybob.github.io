---
import Icon from './Icon.astro';
import type { Project } from '../data/projects';

export interface Props {
  project: Project;
  variant?: 'default' | 'wide';
}

const { project, variant = 'default' } = Astro.props;
---

<article
  class={`project-card project-card--${variant}`}
  style={`--accent:${project.accent};--accent-ink:${project.accentInk}`}
  data-project-card
  data-platform={project.platform}
>
  <a class="project-card__hit" href={`/apps/${project.slug}/`}>
    <span class="sr-only">Open the {project.name} product page</span>
  </a>

  <div class="project-card__head">
    <span class="project-card__icon">
      <img src={project.icon} alt="" width="56" height="56" loading="lazy" decoding="async" />
    </span>
    <div class="project-card__ident">
      <h3 class="project-card__name">{project.name}</h3>
      <p class="project-card__tagline">{project.tagline}</p>
    </div>
  </div>

  <p class="project-card__summary">{project.summary}</p>

  <ul class="project-card__points">
    {
      project.highlights.slice(0, variant === 'wide' ? 5 : 3).map((point) => (
        <li>
          <Icon name="check" size={13} />
          <span>{point}</span>
        </li>
      ))
    }
  </ul>

  <div class="project-card__foot">
    <span class="chip">
      <Icon name={project.platform === 'Android' ? 'android' : 'windows'} size={13} />
      {project.platform}
    </span>
    <span class="chip">{project.version}</span>
    <span class="project-card__cta">
      View project
      <Icon name="arrow-right" size={14} />
    </span>
  </div>
</article>

<style>
  .project-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    padding: clamp(1.25rem, 2.2vw, 1.85rem);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background:
      radial-gradient(
        120% 100% at 100% 0%,
        color-mix(in srgb, var(--accent) 11%, transparent) 0%,
        transparent 58%
      ),
      var(--surface);
    transition:
      transform 0.4s var(--ease-out),
      border-color 0.3s var(--ease),
      box-shadow 0.4s var(--ease-out);
    overflow: hidden;
  }
  .project-card::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    box-shadow: inset 0 1px 0 color-mix(in srgb, var(--text) 7%, transparent);
  }
  .project-card:hover {
    transform: translateY(-4px);
    border-color: color-mix(in srgb, var(--accent) 38%, var(--line));
    box-shadow: var(--shadow);
  }
  .project-card__hit {
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: inherit;
  }
  .project-card__hit:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .project-card__head {
    display: flex;
    align-items: center;
    gap: 0.95rem;
  }
  .project-card__icon {
    flex: none;
    width: 3rem;
    height: 3rem;
    display: grid;
    place-items: center;
    border-radius: 14px;
    background: color-mix(in srgb, var(--accent) 14%, var(--surface-2));
    border: 1px solid color-mix(in srgb, var(--accent) 26%, transparent);
  }
  .project-card__icon img {
    width: 1.85rem;
    height: 1.85rem;
    object-fit: contain;
  }
  .project-card__name {
    font-size: 1.22rem;
    letter-spacing: -0.02em;
  }
  .project-card__tagline {
    font-size: 0.86rem;
    color: var(--text-3);
    margin-top: 0.15rem;
  }
  .project-card__summary {
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--text-2);
  }
  .project-card__points {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    margin-top: auto;
  }
  .project-card__points li {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    font-size: 0.84rem;
    color: var(--text-2);
  }
  .project-card__points svg {
    flex: none;
    margin-top: 0.28em;
    color: var(--accent);
  }
  .project-card__foot {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }
  .project-card__cta {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.84rem;
    font-weight: 560;
    color: var(--accent);
  }
  .project-card__cta svg {
    transition: transform 0.3s var(--ease-out);
  }
  .project-card:hover .project-card__cta svg {
    transform: translateX(4px);
  }

  .project-card--wide {
    grid-column: span 2;
  }
  .project-card--wide .project-card__summary {
    max-width: 58ch;
  }

  @media (max-width: 900px) {
    .project-card--wide {
      grid-column: span 1;
    }
  }
</style>
